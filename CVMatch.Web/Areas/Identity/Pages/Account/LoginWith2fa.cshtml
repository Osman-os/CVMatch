@page
@model CVMatch.Web.Areas.Identity.Pages.Account.LoginWith2faModel
@{
    ViewData["Title"] = "Doğrulama Kodu";
    ViewData["PageClass"] = "cvm-page-wide";
}

<div class="cvm-login-wrap">
    <h1 class="h3 mb-1 text-center">Doğrulama Kodu</h1>
    <p class="text-secondary text-center mb-4">
        Doğrulama uygulamanızdaki altı haneli kodu girin.
    </p>

    <div class="card">
        <div class="card-body">
            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <input asp-for="RememberMe" type="hidden" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                }

                <div class="mb-3">
                    <label asp-for="Input.TwoFactorCode" class="form-label">Kod</label>
                    <input asp-for="Input.TwoFactorCode" class="form-control"
                           autocomplete="off" inputmode="numeric" autofocus />
                    <span asp-validation-for="Input.TwoFactorCode" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="Input.RememberMachine" class="form-check-input" />
                    <label asp-for="Input.RememberMachine" class="form-check-label">
                        Bu cihazı hatırla
                    </label>
                </div>

                <button type="submit" class="btn btn-primary w-100">Doğrula</button>

                <div class="mt-3 text-center">
                    <a asp-page="./LoginWithRecoveryCode"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       class="small text-decoration-none">
                        Telefonunuza erişemiyor musunuz?
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-guard.js"></script>
}