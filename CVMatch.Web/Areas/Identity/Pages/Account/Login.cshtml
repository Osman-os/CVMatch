@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.LoginModel
@{
    ViewData["Title"] = "Yönetici Girişi";
    ViewData["PageClass"] = "cvm-page-wide";
}

<div class="cvm-login-wrap" style="width: 520px !important; max-width: 520px !important; min-width: 520px !important;">
    <h1 class="h3 mb-1 text-center">Yönetici Girişi</h1>
    <p class="text-secondary text-center mb-4">Bu alan yalnızca yetkili kullanıcılar içindir.</p>

    <div class="card">
        <div class="card-body">
            <form id="account" method="post">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                }

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">E-posta Adresi</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Parola</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">Beni hatırla</label>
                </div>

                <button id="login-submit" type="submit" class="btn btn-primary w-100">Giriş Yap</button>

                <div class="mt-3 text-center">
                    <a id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none">
                        Parolanızı mı unuttunuz?
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-guard.js"></script>
}