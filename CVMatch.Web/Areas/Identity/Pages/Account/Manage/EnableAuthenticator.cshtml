@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Manage.Internal.EnableAuthenticatorModel
@{
    ViewData["Title"] = "Doğrulama Uygulaması Kur";
    ViewData["Breadcrumb"] = "Yönetici Paneli / Güvenlik";
}

<div class="cvm-guvenlik-wrap">
       <h1 class="h3 mb-1">Doğrulama Uygulaması Kur</h1>
    <p class="text-secondary mb-4">
        
        Girişte parolanıza ek olarak telefonunuzdaki koddan da soracağız.
    </p>

    <div class="card">
        <div class="card-body">

            <partial name="_StatusMessage" for="StatusMessage" />

            <ol class="mb-0">
                <li class="mb-3">
                    Telefonunuza bir doğrulama uygulaması kurun:
                    Google Authenticator veya Microsoft Authenticator.
                </li>

                <li class="mb-3">
                    Uygulamada yeni hesap ekleyin ve aşağıdaki kodu okutun.
                    Okutamıyorsanız bu anahtarı elle girin:

                    <div class="my-2"><kbd>@Model.SharedKey</kbd></div>

                    <div id="qrCode" class="my-3"></div>
                    <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
                </li>

                <li>
                    Uygulamanın gösterdiği altı haneli kodu girin:

                    <form method="post" class="mt-3">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Code" class="form-label">Doğrulama Kodu</label>
                            <input asp-for="Input.Code" class="form-control"
                                   autocomplete="off" inputmode="numeric" />
                            <span asp-validation-for="Input.Code" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Doğrula ve Etkinleştir</button>
                    </form>
                </li>
            </ol>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/qrcode.min.js"></script>
    <script>
        new QRCode(document.getElementById('qrCode'), {
            text: document.getElementById('qrCodeData').getAttribute('data-url'),
            width: 200,
            height: 200
        });
    </script>
}