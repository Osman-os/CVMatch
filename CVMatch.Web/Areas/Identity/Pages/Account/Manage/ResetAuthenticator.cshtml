@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Manage.Internal.ResetAuthenticatorModel
@{
    ViewData["Title"] = "Doğrulama Uygulamasını Sıfırla";
    ViewData["Breadcrumb"] = "Yönetici Paneli / Güvenlik";
}

<div class="cvm-guvenlik-wrap">
    <h1 class="h3 mb-4">Doğrulama Uygulamasını Sıfırla</h1>
    
    <div class="alert alert-warning">
        <strong>Bu işlem geri alınamaz.</strong>
        Mevcut anahtar geçersiz olur; doğrulama uygulamanızdaki kayıt artık çalışmaz
        ve kurulumu baştan yapmanız gerekir.
    </div>

    <p class="text-secondary">
        Telefonunuzu değiştirdiyseniz veya uygulamayı sildiyseniz bu adımı kullanın.
    </p>

    <form method="post">
        <button type="submit" class="btn btn-danger">Sıfırla</button>
        <a asp-page="./TwoFactorAuthentication" class="btn btn-outline-secondary">Vazgeç</a>
    </form>
</div>