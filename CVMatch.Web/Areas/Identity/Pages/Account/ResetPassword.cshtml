@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.ResetPasswordModel
@{
    ViewData["Title"] = "Yeni Parola Belirle";
    ViewData["PageClass"] = "cvm-page-wide";
}

<div class="cvm-login-wrap">
    <h1 class="h3 mb-1 text-center">Yeni Parola Belirle</h1>
    <p class="text-secondary text-center mb-4">
        Hesabınız için yeni bir parola oluşturun.
    </p>

    <div class="card">
        <div class="card-body">
            <form method="post">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                }

                <input asp-for="Input.Code" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">E-posta Adresi</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Yeni Parola</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Yeni Parola (Tekrar)</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Parolayı Güncelle</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-guard.js"></script>
}