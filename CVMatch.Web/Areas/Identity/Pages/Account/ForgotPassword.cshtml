@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.ForgotPasswordModel
@{
    ViewData["Title"] = "Parola Sıfırlama";
    ViewData["PageClass"] = "cvm-page-wide";
}

<div class="cvm-login-wrap">
    <h1 class="h3 mb-1 text-center">Parolanızı mı unuttunuz?</h1>
    <p class="text-secondary text-center mb-4">
        Hesabınızın e-posta adresini girin, sıfırlama bağlantısını gönderelim.
    </p>

    <div class="card">
        <div class="card-body">
            <form method="post">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                }

                <div class="mb-4">
                    <label asp-for="Input.Email" class="form-label">E-posta Adresi</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Sıfırlama Bağlantısı Gönder</button>

                <div class="mt-3 text-center">
                    <a asp-page="./Login" class="small text-decoration-none">Giriş sayfasına dön</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-guard.js"></script>
}