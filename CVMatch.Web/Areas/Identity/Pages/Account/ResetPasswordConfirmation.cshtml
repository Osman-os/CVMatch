@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Parola Güncellendi";
    ViewData["PageClass"] = "cvm-page-wide";
}

<div class="cvm-login-wrap">
    <div class="card">
        <div class="card-body text-center">
            <h1 class="h4 mb-3">Parolanız güncellendi</h1>
            <p class="text-secondary mb-4">
                Yeni parolanızla giriş yapabilirsiniz.
            </p>
            <a asp-page="./Login" class="btn btn-primary">Giriş Yap</a>
        </div>
    </div>
</div>