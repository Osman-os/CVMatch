@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Kurtarma Kodu";
    ViewData["PageClass"] = "cvm-page-wide";
}

<div class="cvm-login-wrap">
    <h1 class="h3 mb-1 text-center">Kurtarma Kodu</h1>
    <p class="text-secondary text-center mb-4">
        Kurulum sırasında aldığınız kurtarma kodlarından birini girin.
        Her kod yalnızca bir kez kullanılabilir.
    </p>

    <div class="card">
        <div class="card-body">
            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                }

                <div class="mb-4">
                    <label asp-for="Input.RecoveryCode" class="form-label">Kurtarma Kodu</label>
                    <input asp-for="Input.RecoveryCode" class="form-control"
                           autocomplete="off" autofocus />
                    <span asp-validation-for="Input.RecoveryCode" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-guard.js"></script>
}