@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Bağlantı Gönderildi";
    ViewData["PageClass"] = "cvm-page-wide";
}

<div class="cvm-login-wrap">
    <div class="card">
        <div class="card-body text-center">
            <h1 class="h4 mb-3">Bağlantı gönderildi</h1>
            <p class="text-secondary mb-4">
                Adres sistemde kayıtlıysa parola sıfırlama bağlantısı e-postanıza gönderildi.
                Gelen kutunuzu ve spam klasörünüzü kontrol edin.
            </p>
            <a asp-page="./Login" class="btn btn-outline-secondary">Giriş sayfasına dön</a>
        </div>
    </div>
</div>