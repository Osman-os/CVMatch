@model CVMatch.Web.Models.ViewModels.JobPostingEditViewModel
@using CVMatch.Web.Models.Enums
@{
    ViewData["Title"] = Model.YeniMi ? "Yeni İlan" : "İlanı Düzenle";
}

<div class="mb-3">
    <a asp-action="Index" class="text-secondary small text-decoration-none">← İlanlar</a>
</div>

<h1 class="h3 mb-4">@ViewData["Title"]</h1>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

    <div class="row g-4">
        <div class="col-lg-8">

            <div class="card mb-4">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control"
                               placeholder="Örn: Junior .NET Geliştirici" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="EmploymentType" class="form-label"></label>
                            <select asp-for="EmploymentType" class="form-select">
                                <option value="@((int)EmploymentType.Internship)">Staj</option>
                                <option value="@((int)EmploymentType.FullTime)">Tam Zamanlı</option>
                            </select>
                            <span asp-validation-for="EmploymentType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CityId" class="form-label"></label>
                            <select asp-for="CityId" class="form-select" asp-items="Model.Cities">
                                <option value="">Fark etmez</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="MinExperienceYears" class="form-label"></label>
                            <input asp-for="MinExperienceYears" type="number" min="0" max="40"
                                   class="form-control" />
                            <span asp-validation-for="MinExperienceYears" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="6"
                                  placeholder="İlanın detayları, sorumluluklar, aranan nitelikler"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h2 class="h5 mb-1">Aranan Yetenekler</h2>
                    <p class="text-secondary small">
                        <strong>Zorunlu</strong> yetenekler eşleştirme skorunda daha ağır basar.
                        <strong>Tercih</strong> edilenler artı puan getirir.
                    </p>

                    <div class="border rounded" style="max-height: 380px; overflow-y: auto;">
                        <table class="table table-sm mb-0">
                            <thead class="sticky-top bg-white">
                                <tr class="text-secondary small">
                                    <th>Yetenek</th>
                                    <th class="text-center" style="width: 80px;">Yok</th>
                                    <th class="text-center" style="width: 80px;">Tercih</th>
                                    <th class="text-center" style="width: 80px;">Zorunlu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var y in Model.TumYetenekler)
                                {
                                    <tr>
                                        <td class="small">@y.Name</td>
                                        <td class="text-center">
                                            <input class="form-check-input" type="radio"
                                                   name="secim-@y.Id" value="yok"
                                                   checked="@(!y.Zorunlu && !y.Tercih)"
                                                   data-skill="@y.Id" data-tip="yok" />
                                        </td>
                                        <td class="text-center">
                                            <input class="form-check-input" type="radio"
                                                   name="secim-@y.Id" value="tercih"
                                                   checked="@y.Tercih"
                                                   data-skill="@y.Id" data-tip="tercih" />
                                        </td>
                                        <td class="text-center">
                                            <input class="form-check-input" type="radio"
                                                   name="secim-@y.Id" value="zorunlu"
                                                   checked="@y.Zorunlu"
                                                   data-skill="@y.Id" data-tip="zorunlu" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div id="skillInputs"></div>
                </div>
            </div>

        </div>

        <div class="col-lg-4">
            <div class="card position-sticky" style="top: 1rem;">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="@((int)JobPostingStatus.Draft)">Taslak</option>
                            <option value="@((int)JobPostingStatus.Active)">Yayında</option>
                            <option value="@((int)JobPostingStatus.Closed)">Kapalı</option>
                        </select>
                        <div class="form-text">
                            Yalnızca yayındaki ilanlar eşleştirmede kullanılır.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-2">Kaydet</button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Vazgeç</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Radio seçimleri gizli input'lara çevrilir; model iki ayrı liste bekliyor
        const kapsayici = document.getElementById('skillInputs');

        function inputlariKur() {
            kapsayici.innerHTML = '';

            document.querySelectorAll('input[type=radio][data-skill]:checked').forEach(function (r) {
                const tip = r.dataset.tip;
                if (tip === 'yok') return;

                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = tip === 'zorunlu' ? 'ZorunluSkillIds' : 'TercihSkillIds';
                input.value = r.dataset.skill;
                kapsayici.appendChild(input);
            });
        }

        document.querySelectorAll('input[type=radio][data-skill]').forEach(function (r) {
            r.addEventListener('change', inputlariKur);
        });

        inputlariKur();
    </script>
}