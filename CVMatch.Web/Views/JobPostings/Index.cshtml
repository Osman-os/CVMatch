@model CVMatch.Web.Models.ViewModels.JobPostingListViewModel
@using CVMatch.Web.Models.Enums
@{
    ViewData["Title"] = "İlanlar";
    ViewData["Breadcrumb"] = "Yönetici Paneli / İlanlar";

    string DurumMetni(JobPostingStatus s) => s switch
    {
        JobPostingStatus.Draft => "Taslak",
        JobPostingStatus.Active => "Yayında",
        JobPostingStatus.Closed => "Kapalı",
        _ => s.ToString()
    };

    string DurumSinifi(JobPostingStatus s) => s switch
    {
        JobPostingStatus.Draft => "cvm-chip-amber",
        JobPostingStatus.Active => "cvm-chip-green",
        JobPostingStatus.Closed => "cvm-chip-gray",
        _ => "cvm-chip-gray"
    };
    
    string IlanSayfaLinki(int hedefSayfa)
    {
        var parcalar = new List<string>();

        if (!string.IsNullOrWhiteSpace(Model.Arama))
            parcalar.Add("arama=" + Uri.EscapeDataString(Model.Arama));

        if (Model.EmploymentType.HasValue)
            parcalar.Add("employmentType=" + Model.EmploymentType.Value);

        if (Model.Status.HasValue)
            parcalar.Add("status=" + Model.Status.Value);

        if (Model.KapalilariGoster)
            parcalar.Add("kapalilariGoster=true");

        parcalar.Add("sayfa=" + hedefSayfa);

        return Url.Action("Index") + "?" + string.Join("&", parcalar);
    }
}

@if (TempData["Hata"] is string hata)
{
    <div class="alert alert-warning">@hata</div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1">İlanlar</h1>
        <p class="text-secondary mb-0">
            Açık pozisyonları oluşturun, düzenleyin ve eşleştirme sonuçlarını görüntüleyin.
        </p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Yeni İlan Oluştur</a>
</div>

<form method="get" asp-action="Index" class="card mb-3">
    <div class="card-body d-flex gap-3 align-items-center flex-wrap">
        <input type="text" name="arama" value="@Model.Arama"
               class="form-control" style="min-width: 240px; flex: 1;"
               placeholder="İlan ara" />

        <select name="employmentType" class="form-select" style="width: auto;"
                onchange="this.form.submit()">
            <option value="">İlan Tipi: Tümü</option>
            <option value="@((int)EmploymentType.Internship)"
                    selected="@(Model.EmploymentType == EmploymentType.Internship)">Staj</option>
            <option value="@((int)EmploymentType.FullTime)"
                    selected="@(Model.EmploymentType == EmploymentType.FullTime)">İş</option>
        </select>

        <select name="status" class="form-select" style="width: auto;"
                onchange="this.form.submit()">
            <option value="">İlan Durumu: Tümü</option>
            @foreach (var s in Enum.GetValues<JobPostingStatus>())
            {
                <option value="@((int)s)" selected="@(Model.Status == s)">@DurumMetni(s)</option>
            }
        </select>

        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="kapalilariGoster" value="true"
                   id="kapaliGoster" checked="@Model.KapalilariGoster"
                   onchange="this.form.submit()" />
            <label class="form-check-label small" for="kapaliGoster">Kapalıları da göster</label>
        </div>

        @if (Model.FiltreVarMi)
        {
            <a asp-action="Index" class="small text-decoration-underline">Temizle</a>
        }
    </div>
</form>

@if (Model.Ilanlar.Count == 0)
{
    <div class="card">
        <div class="card-body cvm-admin-empty">
            <div class="cvm-admin-empty-icon">▤</div>

            @if (Model.FiltreVarMi)
            {
                <p class="mb-1 fw-semibold">Bu filtrelere uyan ilan bulunamadı</p>
                <p class="cvm-admin-muted small mb-3">Filtreleri değiştirip yeniden deneyin.</p>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Filtreleri Temizle</a>
            }
            else
            {
                <p class="mb-1 fw-semibold">Henüz ilan oluşturulmamış</p>
                <p class="cvm-admin-muted small mb-3">
                    Eşleştirme yapabilmek ve başvuru alabilmek için en az bir ilan gerekir.
                </p>
                <a asp-action="Create" class="btn btn-primary btn-sm">+ Yeni İlan Oluştur</a>
            }
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>İlan</th>
                            <th>İlan Tipi</th>
                            <th>Şehir</th>
                            <th>Minimum Deneyim</th>
                            <th class="text-center">Yetenek</th>
                            <th class="text-center">Başvuru</th>
                            <th>İlan Durumu</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model.Ilanlar)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@i.Title</div>
                                    <div class="text-secondary" style="font-size: .75rem;">
                                        @i.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </div>
                                </td>
                                <td>
                                    <span class="cvm-chip @(i.EmploymentType == EmploymentType.Internship ? "cvm-chip-purple" : "cvm-chip-blue")">
                                        @(i.EmploymentType == EmploymentType.Internship ? "Staj" : "İş")
                                    </span>
                                </td>
                                <td>@(i.CityName ?? "Fark etmez")</td>
                                <td class="small text-secondary">
                                    @(i.MinExperienceYears == 0 ? "—" : $"{i.MinExperienceYears} yıl")
                                </td>
                                <td class="text-center small cvm-admin-muted">@i.SkillCount</td>
                                <td class="text-center">
                                    @if (i.BasvuranSayisi == 0)
                                    {
                                        <span class="cvm-admin-muted small">—</span>
                                    }
                                    else
                                    {
                                        <a asp-action="Match" asp-route-id="@i.Id"
                                           class="fw-semibold text-decoration-none">@i.BasvuranSayisi</a>
                                    }
                                </td>
                                <td><span class="cvm-chip @DurumSinifi(i.Status)">@DurumMetni(i.Status)</span></td>
                                <td class="text-end text-nowrap">
                                    <div class="cvm-islem-grup">
                                        @if (i.Status == JobPostingStatus.Active)
                                        {
                                            <a asp-action="Match" asp-route-id="@i.Id"
                                               class="btn btn-sm btn-outline-primary">Eşleştirme Sonuçları</a>
                                        }
                                        else
                                        {
                                            <span class="btn btn-sm btn-outline-secondary disabled"
                                                  title="Eşleştirme için ilan yayında olmalı">Eşleştirme Sonuçları</span>
                                        }

                                        <div class="dropdown">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary cvm-islem-menu-btn"
                                                    data-bs-toggle="dropdown"
                                                    data-bs-strategy="fixed"
                                                    aria-expanded="false"
                                                    aria-label="Diğer işlemler">⋯</button>

                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@i.Id">
                                                        Düzenle
                                                    </a>
                                                </li>

                                                @if (i.Status == JobPostingStatus.Active)
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item js-link-kopyala"
                                                                data-url="@Url.Action("Apply", "Cv", new { id = i.Id }, Context.Request.Scheme)">
                                                            Başvuru Bağlantısını Kopyala
                                                        </button>
                                                    </li>
                                                }

                                                <li><hr class="dropdown-divider" /></li>

                                                <li>
                                                    <form asp-action="ChangeStatus" method="post" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@i.Id" />

                                                        @if (i.Status != JobPostingStatus.Active)
                                                        {
                                                            <button type="submit" name="status"
                                                                    value="@((int)JobPostingStatus.Active)"
                                                                    class="dropdown-item">Yayınla</button>
                                                        }
                                                        else
                                                        {
                                                            <button type="submit" name="status"
                                                                    value="@((int)JobPostingStatus.Closed)"
                                                                    class="dropdown-item text-danger">İlanı Kapat</button>
                                                        }
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
        <span class="text-secondary small">
            Toplam @Model.ToplamKayit ilan · @Model.Ilanlar.Count tanesi listeleniyor
        </span>

        @if (Model.ToplamSayfa > 1)
        {
            <div class="btn-group">
                <a class="btn btn-outline-secondary btn-sm @(Model.OncekiVar ? "" : "disabled")"
                   href="@IlanSayfaLinki(Model.Sayfa - 1)">Önceki</a>

                <span class="btn btn-outline-secondary btn-sm disabled">
                    @Model.Sayfa / @Model.ToplamSayfa
                </span>

                <a class="btn btn-outline-secondary btn-sm @(Model.SonrakiVar ? "" : "disabled")"
                   href="@IlanSayfaLinki(Model.Sayfa + 1)">Sonraki</a>
            </div>
        }
    </div>
    
    @section Scripts {
    <script>
        document.querySelectorAll('.js-link-kopyala').forEach(function (dugme) {
            dugme.addEventListener('click', async function () {
                const adres = this.dataset.url;
                const eskiMetin = this.textContent;

                try {
                    await navigator.clipboard.writeText(adres);
                    this.textContent = 'Kopyalandı';
                } catch {
                    // Güvenli olmayan bağlamda pano API'si çalışmaz
                    window.prompt('Bağlantıyı kopyalayın:', adres);
                    return;
                }

                setTimeout(() => { this.textContent = eskiMetin; }, 2000);
            });
        });
    </script>
}
}