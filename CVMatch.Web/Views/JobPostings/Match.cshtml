@model CVMatch.Web.Models.ViewModels.MatchResultViewModel
@using CVMatch.Web.Models.Enums
@{
    ViewData["Title"] = $"Eşleştirme — {Model.Title}";
}

<div class="mb-3">
    <a asp-action="Index" class="text-secondary small text-decoration-none">← İlanlar</a>
</div>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.Title</h1>
        <div class="text-secondary small">
            @(Model.CityName ?? "Şehir farketmez")
            &middot;
            @(Model.EmploymentType == EmploymentType.Internship ? "Staj" : "Tam Zamanlı")
            @if (Model.MinExperienceYears > 0)
            {
                <text>&middot; asgari @Model.MinExperienceYears yıl</text>
            }
        </div>
    </div>
    <a asp-action="Edit" asp-route-id="@Model.JobPostingId"
       class="btn btn-sm btn-outline-secondary">İlanı Düzenle</a>
</div>

@if (!Model.YetenekTanimliMi)
{
    <div class="alert alert-warning">
        Bu ilan için yetenek tanımlanmamış. Eşleştirme yapılabilmesi için
        ilana en az bir yetenek eklemelisiniz.
    </div>
    return;
}

<div class="card mb-4">
    <div class="card-body">
        <div class="small text-secondary mb-2">
            Aranan yetenekler — @Model.ZorunluSayisi zorunlu, @Model.TercihSayisi tercih
        </div>
        @foreach (var y in Model.Aranan)
        {
            if (y.Zorunlu)
            {
                <span class="badge text-bg-dark me-1 mb-1">@y.Name</span>
            }
            else
            {
                <span class="badge text-bg-light border me-1 mb-1">@y.Name</span>
            }
        }
        <div class="text-secondary mt-2" style="font-size: .8rem;">
            Skor yalnızca yetenek uyumundan hesaplanır. Zorunlu yetenekler iki kat ağırlıklıdır.
        </div>
    </div>
</div>

@if (Model.Adaylar.Count == 0)
{
    <div class="alert alert-light border">
        Bu ilanın çalışma türüne uygun aday bulunamadı.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr class="text-secondary small">
                    <th style="min-width: 180px;">Aday</th>
                    @foreach (var y in Model.Aranan)
                    {
                        <th class="text-center" style="font-size: .75rem; max-width: 90px;">
                            @if (y.Zorunlu)
                            {
                                <strong>@y.Name</strong>
                            }
                            else
                            {
                                @y.Name
                            }
                        </th>
                    }
                    <th style="min-width: 120px;">Uyum</th>
                    <th>Deneyim</th>
                    <th>Şehir</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Adaylar)
                {
                    <tr>
                        <td>
                            <a asp-controller="Admin" asp-action="Candidate" asp-route-id="@a.Id"
                               class="text-decoration-none fw-semibold">@a.FullName</a>
                            <div class="text-secondary font-monospace" style="font-size: .75rem;">
                                @a.ApplicationReferenceNumber
                            </div>
                            @if (a.EksikZorunluSayisi > 0)
                            {
                                <span class="badge text-bg-warning" style="font-size: .7rem;">
                                    @a.EksikZorunluSayisi zorunlu eksik
                                </span>
                            }
                        </td>

                        @foreach (var y in Model.Aranan)
                        {
                            <td class="text-center">
                                @if (a.Bilir(y.SkillId))
                                {
                                    <span class="text-success fw-bold">✓</span>
                                }
                                else
                                {
                                    <span class="text-secondary">✕</span>
                                }
                            </td>
                        }

                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 6px;">
                                    <div class="progress-bar @a.SkorRengi"
                                         style="width: @a.Skor%"></div>
                                </div>
                                <span class="small fw-semibold" style="min-width: 34px;">%@a.Skor</span>
                            </div>
                        </td>

                        <td class="small">
                            @a.DeneyimMetni
                            @if (!a.DeneyimYeterli)
                            {
                                <span class="text-warning" title="Asgari deneyimin altında">⚠</span>
                            }
                        </td>

                        <td class="small">
                            @if (a.AyniSehir)
                            {
                                <span class="text-success fw-semibold">@a.CityName ✓</span>
                            }
                            else
                            {
                                <span class="text-secondary">@(a.CityName ?? "—")</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-2">
        <div class="text-secondary small">
            @Model.Adaylar.Count aday listelendi.
            @if (Model.GizlenenSayisi > 0)
            {
                <text>@Model.GizlenenSayisi aday eşiğin altında kaldığı için gizlendi.</text>
            }
            Çalışma türü uyuşmayan adaylar gösterilmez.
        </div>

        <form method="get" asp-action="Match" class="d-flex align-items-center gap-2">
            <input type="hidden" name="id" value="@Model.JobPostingId" />
            <label class="text-secondary small mb-0">Asgari uyum</label>
            <select name="asgariSkor" class="form-select form-select-sm" style="width: auto;"
                    onchange="this.form.submit()">
                <option value="0" selected="@(Model.AsgariSkor == 0)">Tümü</option>
                <option value="1" selected="@(Model.AsgariSkor == 1)">%1+</option>
                <option value="25" selected="@(Model.AsgariSkor == 25)">%25+</option>
                <option value="50" selected="@(Model.AsgariSkor == 50)">%50+</option>
                <option value="75" selected="@(Model.AsgariSkor == 75)">%75+</option>
            </select>
        </form>
    </div>
}