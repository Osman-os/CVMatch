@model CVMatch.Web.Models.ViewModels.MatchResultViewModel
@using CVMatch.Web.Models.Enums
@{
    ViewData["Title"] = "Eşleştirme Sonuçları";
    ViewData["Breadcrumb"] = "Yönetici Paneli / İlanlar / Eşleştirme Sonuçları";

    string DurumMetni(JobPostingStatus s) => s switch
    {
        JobPostingStatus.Draft => "Taslak",
        JobPostingStatus.Active => "Yayında",
        JobPostingStatus.Closed => "Kapalı",
        _ => s.ToString()
    };
}

<h1 class="h3 mb-1">Eşleştirme Sonuçları</h1>
<p class="text-secondary mb-4">
    @Model.Title ilanı için adayların uyum sonuçlarını inceleyin.
</p>

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <div class="d-flex align-items-center gap-3">
                <span class="cvm-stat-icon cvm-icon-blue">▤</span>
                <h2 class="h5 mb-0">@Model.Title</h2>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="cvm-chip @(Model.Status == JobPostingStatus.Active ? "cvm-chip-green" : "cvm-chip-gray")">
                    @DurumMetni(Model.Status)
                </span>
                <a asp-action="Edit" asp-route-id="@Model.JobPostingId"
                   class="btn btn-sm btn-outline-secondary">İlanı Düzenle</a>
            </div>
        </div>

        <div class="text-secondary small mb-3">
            İlan Tipi: <strong>@(Model.EmploymentType == EmploymentType.Internship ? "Staj" : "İş")</strong>
            &nbsp;|&nbsp;
            Şehir: <strong>@(Model.CityName ?? "Fark etmez")</strong>
            &nbsp;|&nbsp;
            Minimum Deneyim: <strong>@(Model.MinExperienceYears == 0 ? "—" : $"{Model.MinExperienceYears} yıl")</strong>
        </div>

        @if (Model.YetenekTanimliMi)
        {
            <div class="row g-4 align-items-start">
                <div class="col-lg-8">
                    <div class="text-secondary text-uppercase mb-2" style="font-size: .7rem; letter-spacing: .04em;">
                        Aranan Yetenekler
                    </div>

                    @foreach (var y in Model.Aranan)
                    {
                        if (y.Zorunlu)
                        {
                            <span class="cvm-chip cvm-chip-dark me-1 mb-1">@y.Name</span>
                        }
                        else
                        {
                            <span class="cvm-skill-chip">@y.Name</span>
                        }
                    }
                </div>

                <div class="col-lg-4">
                    <div class="cvm-summary-grid">
                        <div class="cvm-summary-item">
                            <div class="cvm-summary-value">@Model.ToplamAday</div>
                            <div class="cvm-summary-label">Eşleşen Aday</div>
                        </div>
                        <div class="cvm-summary-item">
                            <div class="cvm-summary-value">%@Model.OrtalamaUyum</div>
                            <div class="cvm-summary-label">Ort. Uyum</div>
                        </div>
                        <div class="cvm-summary-item">
                            <div class="cvm-summary-value">@Model.YuksekUyumluSayisi</div>
                            <div class="cvm-summary-label">%80+ Aday</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (!Model.YetenekTanimliMi)
{
    <div class="alert alert-warning">
        Bu ilan için yetenek tanımlanmamış. Eşleştirme yapılabilmesi için
        ilana en az bir yetenek eklemelisiniz.
    </div>
    return;
}

<div class="cvm-note-bar mb-3">
    <span class="cvm-note-icon">ⓘ</span>
    <span>
        <strong>Skor nasıl hesaplanıyor?</strong>
        Yetenek eşleşmesi skoru belirler; zorunlu yetenekler iki kat ağırlıklıdır.
        Şehir, deneyim ve başvuru türü karar desteği olarak gösterilir.
    </span>
</div>

<form method="get" asp-action="Match" class="cvm-toolbar mb-3">
    <input type="hidden" name="id" value="@Model.JobPostingId" />

    <span class="cvm-toolbar-count">@Model.Adaylar.Count aday bulundu</span>

    <div class="d-flex align-items-center gap-3 flex-wrap">
        <div class="d-flex align-items-center gap-2">
            <label class="text-secondary small mb-0">Tür Uyumu</label>
            <select name="turFiltresi" class="form-select form-select-sm" style="width: auto;"
                    onchange="this.form.submit()">
                <option value="tumu" selected="@(Model.TurFiltresi == "tumu")">Tümü</option>
                <option value="uyumlu" selected="@(Model.TurFiltresi == "uyumlu")">Uyumlu</option>
                <option value="uyumsuz" selected="@(Model.TurFiltresi == "uyumsuz")">Uyumsuz</option>
            </select>
        </div>

        <div class="d-flex align-items-center gap-2">
            <label class="text-secondary small mb-0">Asgari Uyum</label>
            <select name="asgariSkor" class="form-select form-select-sm" style="width: auto;"
                    onchange="this.form.submit()">
                <option value="0" selected="@(Model.AsgariSkor == 0)">Tümü</option>
                <option value="1" selected="@(Model.AsgariSkor == 1)">%1+</option>
                <option value="25" selected="@(Model.AsgariSkor == 25)">%25+</option>
                <option value="50" selected="@(Model.AsgariSkor == 50)">%50+</option>
                <option value="75" selected="@(Model.AsgariSkor == 75)">%75+</option>
            </select>
        </div>
    </div>
</form>

@if (Model.Adaylar.Count == 0)
{
    <div class="card">
        <div class="card-body text-center text-secondary py-5">
            Bu filtrelere uyan aday bulunamadı.
        </div>
    </div>
}
else
{
    @foreach (var a in Model.Adaylar)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-4 align-items-start">

                    <div class="col-lg-4">
                        <div class="h6 mb-1">@a.FullName</div>
                        <div class="text-secondary small mb-3">
                            @(a.CityName ?? "Şehir belirtilmemiş") &middot; @a.DeneyimMetni
                        </div>

                        <div class="d-flex flex-column align-items-start gap-2">
                            <span class="cvm-chip @(a.AyniSehir ? "cvm-chip-green" : "cvm-chip-red")">
                                @(a.AyniSehir ? "Şehir uygun" : "Şehir uyumsuz")
                            </span>

                            <span class="cvm-chip @(a.DeneyimYeterli ? "cvm-chip-green" : "cvm-chip-amber")">
                                @(a.DeneyimYeterli ? "Deneyim uygun" : "Deneyim yetersiz")
                            </span>

                            <span class="cvm-chip @(a.TurUyumlu ? "cvm-chip-green" : "cvm-chip-red")">
                                @(a.TurUyumlu ? "Tür uyumlu" : "Tür uyumsuz")
                            </span>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="cvm-group-label">Eşleşen Yetenekler</div>
                        <div class="mb-3">
                            @if (a.EslesenYetenekler.Count == 0)
                            {
                                <span class="text-secondary small">Yok</span>
                            }
                            else
                            {
                                @foreach (var y in a.EslesenYetenekler)
                                {
                                    <span class="cvm-match-yes">✓ @y</span>
                                }
                            }
                        </div>

                        <div class="cvm-group-label">Eksik Yetenekler</div>
                        <div>
                            @if (a.EksikYetenekler.Count == 0)
                            {
                                <span class="text-secondary small">Yok</span>
                            }
                            else
                            {
                                @foreach (var y in a.EksikYetenekler)
                                {
                                    <span class="cvm-match-no">✕ @y</span>
                                }
                            }
                        </div>
                    </div>

                    <div class="col-lg-3 text-lg-end">
                        <div class="cvm-score @a.SkorSinifi">%@a.Skor</div>
                        <div class="cvm-score-label">Uyum Skoru</div>

                        <div class="progress mt-2 ms-lg-auto" style="height: 6px; max-width: 140px;">
                            <div class="progress-bar @a.SkorRengi" style="width: @a.Skor%"></div>
                        </div>

                        <a asp-controller="Admin" asp-action="Candidate" asp-route-id="@a.Id"
                           class="btn btn-sm btn-outline-secondary mt-3">Adayı Görüntüle</a>
                    </div>

                </div>
            </div>
        </div>
    }

    <div class="text-secondary small">
        @if (Model.GizlenenSayisi > 0)
        {
            <text>@Model.GizlenenSayisi aday uyum eşiğinin altında kaldığı için gizlendi.</text>
        }
        @if (Model.TurFiltresi == "tumu" && Model.TurUyumsuzSayisi > 0)
        {
            <text>@Model.TurUyumsuzSayisi adayın başvuru türü bu ilanla uyuşmuyor.</text>
        }
    </div>
}