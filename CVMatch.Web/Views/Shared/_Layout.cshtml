<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CVMatch</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CVMatch.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light cvm-navbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Cv" asp-action="Index">CVMatch</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-label="Menü">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 justify-content-end">
                        <li class="nav-item">
                            <a class="nav-link" href="#nasil-calisir">Nasıl Çalışır</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="cvm-page @ViewData["PageClass"]">
        @RenderBody()
    </main>

    <footer class="cvm-footer">
        <div class="container d-flex justify-content-between flex-wrap gap-2">
            <div>
                <div class="fw-bold">CVMatch</div>
                <div class="text-secondary" style="font-size: .825rem;">
                    CV yükleme ve aday değerlendirme platformu
                </div>
            </div>
            <div class="text-end">
                <a asp-controller="Home" asp-action="Privacy">KVKK Aydınlatma Metni</a>
                <div class="text-secondary" style="font-size: .8rem;">© 2026 CVMatch</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>