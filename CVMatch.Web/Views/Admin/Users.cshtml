@model CVMatch.Web.Models.ViewModels.AdminUserListViewModel
@{
    ViewData["Title"] = "Yöneticiler";
    ViewData["Breadcrumb"] = "Yönetici Paneli / Yöneticiler";
}

<h1 class="h3 mb-1">Yöneticiler</h1>
<p class="text-secondary mb-4">
    Yönetim paneline erişebilecek kullanıcıları yönetin.
</p>

@if (TempData["Bilgi"] is string bilgi)
{
    <div class="alert alert-success">@bilgi</div>
}
@if (TempData["Hata"] is string hata)
{
    <div class="alert alert-warning">@hata</div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>E-posta</th>
                                <th class="text-end" style="width: 120px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var y in Model.Yoneticiler)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@y.Email</span>
                                        @if (y.KendisiMi)
                                        {
                                            <span class="cvm-chip cvm-chip-blue ms-2">Siz</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (!y.KendisiMi)
                                        {
                                            <form asp-action="RemoveUser" method="post" class="d-inline"
                                                  onsubmit="return confirm('@y.Email adresli yönetici kaldırılacak. Bu kişi artık panele giriş yapamayacak. Emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@y.Id" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">Kaldır</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="cvm-admin-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="cvm-admin-muted small mt-3">
            @Model.Yoneticiler.Count yönetici tanımlı. Sistemde en az bir yönetici bulunmalıdır.
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card cvm-yonetici-ekle">
            <div class="card-body">
                <h2 class="h5 mb-1">Yeni Yönetici Ekle</h2>
                <p class="cvm-admin-muted small mb-3">
                    Panele erişecek yeni bir kullanıcı tanımlayın.
                </p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <form asp-action="AddUser" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Yeni.Email" class="form-label"></label>
                        <input asp-for="Yeni.Email" class="form-control" type="email"
                               placeholder="ad.soyad@kurum.com" />
                        <span asp-validation-for="Yeni.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Yeni.Password" class="form-label"></label>
                        <input asp-for="Yeni.Password" class="form-control" id="yeniParola" />
                        <span asp-validation-for="Yeni.Password" class="text-danger small"></span>

                        <ul class="cvm-parola-kural" id="parolaKurallari">
                            <li data-kural="uzunluk">En az 8 karakter</li>
                            <li data-kural="buyuk">Büyük harf</li>
                            <li data-kural="kucuk">Küçük harf</li>
                            <li data-kural="rakam">Rakam</li>
                            <li data-kural="simge">Simge</li>
                        </ul>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Yeni.ConfirmPassword" class="form-label"></label>
                        <input asp-for="Yeni.ConfirmPassword" class="form-control" />
                        <span asp-validation-for="Yeni.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Yönetici Ekle</button>
                </form>

                <div class="cvm-info-box mt-3">
                    Eklenen yönetici doğrudan giriş yapabilir; e-posta doğrulaması istenmez.
                    İlk girişinde iki aşamalı doğrulama kurulumu yapması gerekir.
                    Parolayı ilgili kişiyle güvenli bir kanaldan paylaşın.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Parola kuralları yazdıkça işaretlenir; asıl doğrulama sunucuda
        (function () {
            const alan = document.getElementById('yeniParola');
            const liste = document.getElementById('parolaKurallari');

            if (!alan || !liste) return;

            const kurallar = {
                uzunluk: p => p.length >= 8,
                buyuk:   p => /[A-ZÇĞİÖŞÜ]/.test(p),
                kucuk:   p => /[a-zçğıöşü]/.test(p),
                rakam:   p => /[0-9]/.test(p),
                simge:   p => /[^A-Za-zÇĞİÖŞÜçğıöşü0-9]/.test(p)
            };

            alan.addEventListener('input', function () {
                const parola = alan.value;

                liste.querySelectorAll('li').forEach(function (satir) {
                    const ad = satir.dataset.kural;
                    satir.classList.toggle('saglandi', parola.length > 0 && kurallar[ad](parola));
                });
            });
        })();
    </script>
}