@model CVMatch.Web.Models.ViewModels.AdminDashboardViewModel
@using CVMatch.Web.Models.Enums
@{
    ViewData["Title"] = "Genel Bakış";
    ViewData["Breadcrumb"] = "Yönetici Paneli / Genel Bakış";

    string DurumMetni(ApplicationStatus s) => s switch
    {
        ApplicationStatus.New => "Yeni",
        ApplicationStatus.UnderReview => "İnceleniyor",
        ApplicationStatus.Suitable => "Uygun",
        ApplicationStatus.NotSuitable => "Uygun Değil",
        _ => s.ToString()
    };

    string DurumSinifi(ApplicationStatus s) => s switch
    {
        ApplicationStatus.New => "cvm-chip-blue",
        ApplicationStatus.UnderReview => "cvm-chip-amber",
        ApplicationStatus.Suitable => "cvm-chip-green",
        ApplicationStatus.NotSuitable => "cvm-chip-red",
        _ => "cvm-chip-gray"
    };
}

<h1 class="h3 mb-1">Genel Bakış</h1>
<p class="text-secondary mb-4">Başvurular ve ilanlarla ilgili güncel durumu görüntüleyin.</p>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="cvm-stat-icon cvm-icon-blue">◍</span>
                <div>
                    <div class="text-secondary small">Toplam Aday</div>
                    <div class="h3 mb-0">@Model.ToplamBasvuru</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="cvm-stat-icon cvm-icon-indigo">▤</span>
                <div>
                    <div class="text-secondary small">Yeni Başvuru</div>
                    <div class="h3 mb-0">@Model.YeniBasvuru</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="cvm-stat-icon cvm-icon-amber">◷</span>
                <div>
                    <div class="text-secondary small">Son 7 Gün</div>
                    <div class="h3 mb-0">@Model.SonYediGun</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="cvm-stat-icon cvm-icon-green">▣</span>
                <div>
                    <div class="text-secondary small">Yayındaki İlan</div>
                    <div class="h3 mb-0">@Model.AktifIlan</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 mb-0">Son Başvurular</h2>
                    <a asp-action="Candidates" class="small text-decoration-none">Tümünü Gör →</a>
                </div>

                @if (Model.SonBasvurular.Count == 0)
                {
                    <p class="text-secondary mb-0">Henüz başvuru yok.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Aday</th>
                                    <th>Şehir</th>
                                    <th>Deneyim</th>
                                    <th>Durum</th>
                                    <th>Tarih</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.SonBasvurular)
                                {
                                    <tr>
                                        <td class="fw-semibold">@b.FullName</td>
                                        <td>@(b.CityName ?? "—")</td>
                                        <td class="small text-secondary">@b.DeneyimMetni</td>
                                        <td>
                                            <span class="cvm-chip @DurumSinifi(b.Status)">
                                                @DurumMetni(b.Status)
                                            </span>
                                        </td>
                                        <td class="small text-secondary">
                                            @b.SubmittedAt.ToLocalTime().ToString("dd MMMM yyyy")
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="Candidate" asp-route-id="@b.Id"
                                               class="btn btn-sm btn-outline-secondary">Görüntüle</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">İlan Durumu</h2>

                <div class="cvm-status-row">
                    <span><span class="cvm-dot cvm-dot-green"></span> Yayında</span>
                    <strong>@Model.AktifIlan İlan</strong>
                </div>
                <div class="cvm-status-row">
                    <span><span class="cvm-dot cvm-dot-amber"></span> Taslak</span>
                    <strong>@Model.TaslakIlan İlan</strong>
                </div>
                <div class="cvm-status-row">
                    <span><span class="cvm-dot cvm-dot-gray"></span> Kapalı</span>
                    <strong>@Model.KapaliIlan İlan</strong>
                </div>

                <div class="cvm-info-box mt-3">
                    Son 7 günde toplam @Model.SonYediGun yeni aday başvuruda bulundu.
                </div>
            </div>
        </div>
    </div>
</div>