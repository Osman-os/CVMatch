@model CVMatch.Web.Models.ViewModels.AdminCandidateDetailViewModel
@using CVMatch.Web.Models.Enums
@{
    ViewData["Title"] = Model.FullName;

    string DurumMetni(ApplicationStatus s) => s switch
    {
        ApplicationStatus.New => "Yeni",
        ApplicationStatus.UnderReview => "İnceleniyor",
        ApplicationStatus.Suitable => "Uygun",
        ApplicationStatus.NotSuitable => "Uygun Değil",
        _ => s.ToString()
    };

    string DurumRengi(ApplicationStatus s) => s switch
    {
        ApplicationStatus.New => "text-bg-primary",
        ApplicationStatus.UnderReview => "text-bg-warning",
        ApplicationStatus.Suitable => "text-bg-success",
        ApplicationStatus.NotSuitable => "text-bg-secondary",
        _ => "text-bg-light"
    };

    string Tarih(DateOnly? d) => d?.ToString("MM/yyyy") ?? "—";
}

<div class="mb-3">
    <a asp-action="Candidates" class="text-secondary small text-decoration-none">← Aday listesi</a>
</div>

@if (TempData["Bilgi"] is string bilgi)
{
    <div class="alert alert-success">@bilgi</div>
}
@if (TempData["Hata"] is string hata)
{
    <div class="alert alert-danger">@hata</div>
}

<div class="d-flex align-items-center gap-3 mb-4">
    @if (Model.HasPhoto)
    {
        <img src="@Url.Action("CandidateFile", new { id = Model.Id, type = "photo" })"
             class="rounded border" alt="@Model.FullName"
             style="width: 72px; height: 72px; object-fit: cover;" />
    }
    <div>
        <h1 class="h3 mb-1">@Model.FullName</h1>
        <span class="font-monospace small text-secondary">@Model.ApplicationReferenceNumber</span>
        <span class="badge @DurumRengi(Model.Status) ms-2">@DurumMetni(Model.Status)</span>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Kişisel Bilgiler</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4 fw-normal text-secondary">E-posta</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4 fw-normal text-secondary">Telefon</dt>
                    <dd class="col-sm-8">@(Model.PhoneNumber ?? "—")</dd>

                    <dt class="col-sm-4 fw-normal text-secondary">Şehir</dt>
                    <dd class="col-sm-8">@(Model.CityName ?? "—")</dd>

                    @if (!string.IsNullOrWhiteSpace(Model.Address))
                    {
                        <dt class="col-sm-4 fw-normal text-secondary">Adres</dt>
                        <dd class="col-sm-8">@Model.Address</dd>
                    }

                    <dt class="col-sm-4 fw-normal text-secondary">Deneyim</dt>
                    <dd class="col-sm-8">@Model.DeneyimMetni</dd>

                    <dt class="col-sm-4 fw-normal text-secondary">Başvuru Türü</dt>
                    <dd class="col-sm-8">
                        @(Model.PreferredEmploymentType == EmploymentType.Internship ? "Staj" : "Tam Zamanlı")
                    </dd>

                    @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl))
                    {
                        <dt class="col-sm-4 fw-normal text-secondary">LinkedIn</dt>
                        <dd class="col-sm-8 text-break small">@Model.LinkedInUrl</dd>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.GitHubUrl))
                    {
                        <dt class="col-sm-4 fw-normal text-secondary">GitHub</dt>
                        <dd class="col-sm-8 text-break small">@Model.GitHubUrl</dd>
                    }

                    <dt class="col-sm-4 fw-normal text-secondary">Başvuru Tarihi</dt>
                    <dd class="col-sm-8">@Model.SubmittedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>

                    @if (Model.UpdatedAt.HasValue)
                    {
                        <dt class="col-sm-4 fw-normal text-secondary">Son Güncelleme</dt>
                        <dd class="col-sm-8">@Model.UpdatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                    }
                </dl>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Yetenekler</h2>
                @if (Model.Skills.Count == 0)
                {
                    <p class="text-secondary mb-0">Yetenek kaydı yok.</p>
                }
                else
                {
                    @foreach (var s in Model.Skills)
                    {
                        <span class="badge rounded-pill text-bg-light border me-1 mb-1">@s</span>
                    }
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Eğitim</h2>
                @if (Model.Educations.Count == 0)
                {
                    <p class="text-secondary mb-0">Eğitim kaydı yok.</p>
                }
                else
                {
                    @foreach (var e in Model.Educations)
                    {
                        <div class="mb-3 pb-3 border-bottom">
                            <div class="fw-semibold">@e.School</div>
                            <div class="text-secondary small">@e.FieldOfStudy</div>
                            <div class="text-secondary small">
                                @Tarih(e.StartDate) &ndash; @(e.IsCurrent ? "Devam ediyor" : Tarih(e.EndDate))
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">İş Deneyimi</h2>
                @if (Model.WorkExperiences.Count == 0)
                {
                    <p class="text-secondary mb-0">Deneyim kaydı yok.</p>
                }
                else
                {
                    @foreach (var w in Model.WorkExperiences)
                    {
                        <div class="mb-3 pb-3 border-bottom">
                            <div class="fw-semibold">@w.Position</div>
                            <div class="text-secondary small">@w.CompanyName</div>
                            <div class="text-secondary small">
                                @Tarih(w.StartDate) &ndash; @(w.IsCurrent ? "Devam ediyor" : Tarih(w.EndDate))
                            </div>
                            @if (!string.IsNullOrWhiteSpace(w.Description))
                            {
                                <div class="small mt-1">@w.Description</div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Yönetici Notları</h2>

                <form asp-action="AddNote" method="post" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-2">
                        <textarea name="content" class="form-control" rows="2"
                                  placeholder="Bu aday hakkında not ekleyin"></textarea>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">Not Ekle</button>
                </form>

                @if (Model.Notes.Count == 0)
                {
                    <p class="text-secondary small mb-0">Henüz not yok.</p>
                }
                else
                {
                    @foreach (var n in Model.Notes)
                    {
                        <div class="border-top pt-2 mt-2">
                            <div class="small">@n.Content</div>
                            <div class="text-secondary" style="font-size: .8rem;">
                                @n.AuthorEmail — @n.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

    </div>

    <div class="col-lg-4">

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Durum</h2>
                <form asp-action="ChangeStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <select name="status" class="form-select mb-2">
                        @foreach (var s in Enum.GetValues<ApplicationStatus>())
                        {
                            <option value="@((int)s)" selected="@(Model.Status == s)">@DurumMetni(s)</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary w-100">Güncelle</button>
                </form>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">CV</h2>

                @if (Model.SubmissionId is null)
                {
                    <p class="text-secondary small mb-0">
                        Bu adaya ait CV dosyası bulunamadı.
                    </p>
                }
                else
                {
                    <p class="small text-break mb-2">@Model.OriginalFileName</p>

                    @if (Model.HasPreview)
                    {
                        <img src="@Url.Action("CandidateFile", new { id = Model.Id, type = "preview" })"
                             class="img-fluid border rounded mb-2" alt="CV önizlemesi" />
                    }

                    <a asp-action="CandidateFile" asp-route-id="@Model.Id" asp-route-type="pdf"
                       target="_blank" class="btn btn-outline-secondary btn-sm w-100">PDF'i Aç</a>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h6 mb-2">Düzenleme Yetkisi</h2>
                @if (Model.EditTokenGecerliMi)
                {
                    <p class="small text-secondary mb-0">
                        Aday @Model.EditTokenExpiresAt.ToLocalTime().ToString("dd.MM.yyyy")
                        tarihine kadar başvurusunu düzenleyebilir.
                    </p>
                }
                else
                {
                    <p class="small text-secondary mb-0">
                        Adayın düzenleme süresi dolmuş.
                    </p>
                }
            </div>
        </div>

    </div>
</div>