@model CVMatch.Web.Models.ViewModels.AdminCandidateDetailViewModel
@using CVMatch.Web.Models.Enums
@{
    ViewData["Title"] = Model.FullName;
    ViewData["Breadcrumb"] = $"Yönetici Paneli / Adaylar / {Model.FullName}";

    string DurumMetni(ApplicationStatus s) => s switch
    {
        ApplicationStatus.New => "Yeni",
        ApplicationStatus.UnderReview => "İnceleniyor",
        ApplicationStatus.Suitable => "Uygun",
        ApplicationStatus.NotSuitable => "Uygun Değil",
        _ => s.ToString()
    };

    string DurumSinifi(ApplicationStatus s) => s switch
    {
        ApplicationStatus.New => "cvm-chip-blue",
        ApplicationStatus.UnderReview => "cvm-chip-amber",
        ApplicationStatus.Suitable => "cvm-chip-green",
        ApplicationStatus.NotSuitable => "cvm-chip-red",
        _ => "cvm-chip-gray"
    };

    string Tarih(DateOnly? d) => d?.ToString("MM/yyyy") ?? "—";

    var basHarfler = string.Join("", Model.FullName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(p => p[..1].ToUpperInvariant()));
}

@if (TempData["Bilgi"] is string bilgi)
{
    <div class="alert alert-success">@bilgi</div>
}
@if (TempData["Hata"] is string hata)
{
    <div class="alert alert-danger">@hata</div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="d-flex align-items-center gap-3">
        @if (Model.HasPhoto)
        {
            <img src="@Url.Action("CandidateFile", new { id = Model.Id, type = "photo" })"
                 class="rounded-circle border" alt="@Model.FullName"
                 style="width: 56px; height: 56px; object-fit: cover;" />
        }
        else
        {
            <span class="cvm-avatar" style="width: 56px; height: 56px; font-size: 1rem;">@basHarfler</span>
        }

        <div>
            <h1 class="h3 mb-1">@Model.FullName</h1>
            <div class="text-secondary small">
                Başvuru No: <span class="font-monospace">@Model.ApplicationReferenceNumber</span>
                &nbsp;&middot;&nbsp;
                Başvuru Tarihi: @Model.SubmittedAt.ToLocalTime().ToString("dd MMMM yyyy")
            </div>
        </div>
    </div>

    <span class="cvm-chip @DurumSinifi(Model.Status)">@DurumMetni(Model.Status)</span>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="ChangeStatus" method="post" class="d-flex align-items-center gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <label class="form-label mb-0 fw-semibold">Başvuru Durumu</label>

            <select name="status" class="form-select" style="width: auto;">
                @foreach (var s in Enum.GetValues<ApplicationStatus>())
                {
                    <option value="@((int)s)" selected="@(Model.Status == s)">@DurumMetni(s)</option>
                }
            </select>

            <button type="submit" class="btn btn-primary">Durumu Güncelle</button>
        </form>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Aday Bilgileri</h2>

                <div class="cvm-detail-row">
                    <span class="cvm-detail-label">E-posta</span>
                    <span>@Model.Email</span>
                </div>
                <div class="cvm-detail-row">
                    <span class="cvm-detail-label">Telefon</span>
                    <span>@(Model.PhoneNumber ?? "—")</span>
                </div>
                <div class="cvm-detail-row">
                    <span class="cvm-detail-label">Başvuru Türü</span>
                    <span>@(Model.PreferredEmploymentType == EmploymentType.Internship ? "Staj" : "Tam Zamanlı İş")</span>
                </div>
                <div class="cvm-detail-row">
                    <span class="cvm-detail-label">Şehir</span>
                    <span>@(Model.CityName ?? "—")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Address))
                {
                    <div class="cvm-detail-row">
                        <span class="cvm-detail-label">Açık Adres</span>
                        <span>@Model.Address</span>
                    </div>
                }
                <div class="cvm-detail-row">
                    <span class="cvm-detail-label">Toplam Deneyim</span>
                    <span>@Model.DeneyimMetni</span>
                </div>
                @if (Model.UpdatedAt.HasValue)
                {
                    <div class="cvm-detail-row">
                        <span class="cvm-detail-label">Son Güncelleme</span>
                        <span>@Model.UpdatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Yetenekler</h2>
                @if (Model.Skills.Count == 0)
                {
                    <p class="text-secondary mb-0">Yetenek kaydı yok.</p>
                }
                else
                {
                    @foreach (var s in Model.Skills)
                    {
                        <span class="cvm-skill-chip">@s</span>
                    }
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Eğitim</h2>
                @if (Model.Educations.Count == 0)
                {
                    <p class="text-secondary mb-0">Eğitim kaydı yok.</p>
                }
                else
                {
                    @foreach (var e in Model.Educations)
                    {
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <div class="fw-semibold">@e.School</div>
                                <div class="text-secondary small">@e.FieldOfStudy</div>
                            </div>
                            <div class="text-secondary small text-nowrap">
                                @Tarih(e.StartDate) &ndash; @(e.IsCurrent ? "Devam ediyor" : Tarih(e.EndDate))
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">İş Deneyimi</h2>
                @if (Model.WorkExperiences.Count == 0)
                {
                    <p class="text-secondary mb-0">Deneyim kaydı yok.</p>
                }
                else
                {
                    @foreach (var w in Model.WorkExperiences)
                    {
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="fw-semibold">@w.Position</div>
                                <div class="text-secondary small text-nowrap">
                                    @Tarih(w.StartDate) &ndash; @(w.IsCurrent ? "Devam ediyor" : Tarih(w.EndDate))
                                </div>
                            </div>
                            <div class="cvm-company">@w.CompanyName</div>
                            @if (!string.IsNullOrWhiteSpace(w.Description))
                            {
                                <div class="small mt-1">@w.Description</div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl) || !string.IsNullOrWhiteSpace(Model.GitHubUrl))
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Bağlantılar</h2>

                    @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl))
                    {
                        <div class="cvm-link-box">
                            <div>
                                <div class="text-secondary" style="font-size: .75rem;">LinkedIn</div>
                                <a href="@Model.LinkedInUrl" target="_blank" rel="noopener"
                                   class="small text-break">@Model.LinkedInUrl</a>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.GitHubUrl))
                    {
                        <div class="cvm-link-box">
                            <div>
                                <div class="text-secondary" style="font-size: .75rem;">GitHub</div>
                                <a href="@Model.GitHubUrl" target="_blank" rel="noopener"
                                   class="small text-break">@Model.GitHubUrl</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Yönetici Notları</h2>

                <form asp-action="AddNote" method="post" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <textarea name="content" class="form-control mb-2" rows="2"
                              placeholder="Bu aday hakkında not ekleyin"></textarea>
                    <button type="submit" class="btn btn-sm btn-primary">Not Ekle</button>
                </form>

                @if (Model.Notes.Count == 0)
                {
                    <p class="text-secondary small mb-0">Henüz not yok.</p>
                }
                else
                {
                    @foreach (var n in Model.Notes)
                    {
                        <div class="cvm-note">
                            <div class="small">@n.Content</div>
                            <div class="text-secondary" style="font-size: .75rem;">
                                @n.AuthorEmail — @n.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

    </div>

    <div class="col-xl-4">
        <div class="card position-sticky" style="top: 1rem;">
            <div class="card-body">
                <h2 class="h5 mb-3">CV Önizlemesi</h2>

                @if (Model.SubmissionId is null)
                {
                    <p class="text-secondary small mb-0">Bu adaya ait CV dosyası bulunamadı.</p>
                }
                else
                {
                    @if (Model.HasPreview)
                    {
                        <img src="@Url.Action("CandidateFile", new { id = Model.Id, type = "preview" })"
                             class="img-fluid border rounded mb-3" alt="CV önizlemesi" />
                    }

                    <div class="text-secondary small text-break mb-2">@Model.OriginalFileName</div>

                    <a asp-action="CandidateFile" asp-route-id="@Model.Id" asp-route-type="pdf"
                       target="_blank" class="btn btn-outline-secondary btn-sm w-100">PDF'i İndir</a>
                }

                <hr />

                <div class="text-secondary" style="font-size: .8rem;">
                    @if (Model.EditTokenGecerliMi)
                    {
                        <text>
                            Aday @Model.EditTokenExpiresAt.ToLocalTime().ToString("dd.MM.yyyy")
                            tarihine kadar başvurusunu düzenleyebilir.
                        </text>
                    }
                    else
                    {
                        <text>Adayın düzenleme süresi dolmuş.</text>
                    }
                </div>
            </div>
        </div>
    </div>
</div>