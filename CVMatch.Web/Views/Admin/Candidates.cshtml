@model CVMatch.Web.Models.ViewModels.AdminCandidateListViewModel
@using CVMatch.Web.Models.Enums
@{
    ViewData["Title"] = "Adaylar";
    ViewData["Breadcrumb"] = "Yönetici Paneli / Adaylar";

    string DurumMetni(ApplicationStatus s) => s switch
    {
        ApplicationStatus.New => "Yeni",
        ApplicationStatus.UnderReview => "İnceleniyor",
        ApplicationStatus.Suitable => "Uygun",
        ApplicationStatus.NotSuitable => "Uygun Değil",
        _ => s.ToString()
    };

    string DurumSinifi(ApplicationStatus s) => s switch
    {
        ApplicationStatus.New => "cvm-chip-blue",
        ApplicationStatus.UnderReview => "cvm-chip-amber",
        ApplicationStatus.Suitable => "cvm-chip-green",
        ApplicationStatus.NotSuitable => "cvm-chip-red",
        _ => "cvm-chip-gray"
    };
}

<h1 class="h3 mb-1">Adaylar</h1>
<p class="text-secondary mb-4">Başvuruları arayın, filtreleyin ve inceleyin.</p>

<form method="get" asp-action="Candidates" id="filterForm">

    <div class="card mb-3">
        <div class="card-body d-flex gap-3 align-items-center">
            <input type="text" name="arama" value="@Model.Arama"
                   class="form-control" placeholder="Aday ara — ad, e-posta veya başvuru no" />

            <button type="button" class="btn btn-outline-secondary flex-shrink-0"
                    data-bs-toggle="offcanvas" data-bs-target="#filtrePaneli">
                Gelişmiş Filtreler
                @if (Model.AktifFiltreSayisi > 0)
                {
                    <span class="badge rounded-pill text-bg-primary ms-1">@Model.AktifFiltreSayisi</span>
                }
            </button>
        </div>
    </div>

    @if (Model.FiltreVarMi)
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            @if (!string.IsNullOrWhiteSpace(Model.Arama))
            {
                <span class="cvm-filter-chip">Arama: @Model.Arama</span>
            }
            @if (Model.SecilenSehir is not null)
            {
                <span class="cvm-filter-chip">Şehir: @Model.SecilenSehir</span>
            }
            @if (Model.EmploymentType.HasValue)
            {
                <span class="cvm-filter-chip">
                    Başvuru Türü: @(Model.EmploymentType == EmploymentType.Internship ? "Staj" : "Tam Zamanlı")
                </span>
            }
            @if (Model.Status.HasValue)
            {
                <span class="cvm-filter-chip">Durum: @DurumMetni(Model.Status.Value)</span>
            }

            @if (Model.MinDeneyimYil.HasValue)
            {
                <span class="cvm-filter-chip">
                    Deneyim: @(Model.MinDeneyimYil == 0 ? "Tümü" : $"{Model.MinDeneyimYil}+ yıl")
                </span>
            }
            
            @foreach (var y in Model.SecilenYetenekler)
            {
                <span class="cvm-filter-chip">Yetenek: @y</span>
            }

            <a asp-action="Candidates" class="small text-decoration-underline">Filtreleri Temizle</a>
        </div>
    }

    <div class="offcanvas offcanvas-end" tabindex="-1" id="filtrePaneli">
        <div class="offcanvas-header border-bottom">
            <h2 class="h5 mb-0">Gelişmiş Filtreler</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>

        <div class="offcanvas-body">

            <h3 class="h6 text-secondary">Başvuru Türü</h3>
            <select name="employmentType" class="form-select mb-4">
                <option value="">Tümü</option>
                <option value="@((int)EmploymentType.Internship)"
                        selected="@(Model.EmploymentType == EmploymentType.Internship)">Staj</option>
                <option value="@((int)EmploymentType.FullTime)"
                        selected="@(Model.EmploymentType == EmploymentType.FullTime)">Tam Zamanlı</option>
            </select>

            <h3 class="h6 text-secondary">Başvuru Durumu</h3>
            <select name="status" class="form-select mb-4">
                <option value="">Tümü</option>
                @foreach (var s in Enum.GetValues<ApplicationStatus>())
                {
                    <option value="@((int)s)" selected="@(Model.Status == s)">@DurumMetni(s)</option>
                }
            </select>

            <h3 class="h6 text-secondary">Deneyim</h3>
            <select name="minDeneyimYil" class="form-select mb-4">
                <option value="">Tümü</option>
                <option value="0" selected="@(Model.MinDeneyimYil == 0)">Deneyimsiz dahil</option>
                <option value="1" selected="@(Model.MinDeneyimYil == 1)">1 yıl ve üzeri</option>
                <option value="2" selected="@(Model.MinDeneyimYil == 2)">2 yıl ve üzeri</option>
                <option value="3" selected="@(Model.MinDeneyimYil == 3)">3 yıl ve üzeri</option>
                <option value="5" selected="@(Model.MinDeneyimYil == 5)">5 yıl ve üzeri</option>
            </select>

            <h3 class="h6 text-secondary">Şehir</h3>
            <select name="cityId" class="form-select mb-4" asp-items="Model.Cities">
                <option value="">Tümü</option>
            </select>

            <h3 class="h6 text-secondary">Yetenekler</h3>
            <p class="small text-secondary">Seçilenlerin hepsine sahip adaylar listelenir.</p>

            <div class="border rounded p-2 mb-4" style="max-height: 320px; overflow-y: auto;">
                @foreach (var y in Model.TumYetenekler)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="skillIds"
                               value="@y.Id" id="skill-@y.Id" checked="@y.Secili" />
                        <label class="form-check-label small" for="skill-@y.Id">@y.Name</label>
                    </div>
                }
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Candidates" class="btn btn-outline-secondary flex-fill">Sıfırla</a>
                <button type="submit" class="btn btn-primary flex-fill">Filtrele</button>
            </div>
        </div>
    </div>

    <button type="submit" class="d-none">Ara</button>
</form>

@if (Model.Adaylar.Count == 0)
{
    <div class="card">
        <div class="card-body text-center text-secondary py-5">
            @(Model.FiltreVarMi ? "Bu filtrelere uyan aday bulunamadı." : "Henüz başvuru yok.")
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Aday</th>
                            <th>Başvuru Türü</th>
                            <th>Şehir</th>
                            <th>Deneyim</th>
                            <th>Yetenekler</th>
                            <th>Durum</th>
                            <th>Tarih</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Adaylar)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="cvm-avatar">@a.BasHarfler</span>
                                        <div>
                                            <div class="fw-semibold">@a.FullName</div>
                                            <div class="text-secondary" style="font-size: .75rem;">@a.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="cvm-chip @(a.PreferredEmploymentType == EmploymentType.Internship ? "cvm-chip-purple" : "cvm-chip-blue")">
                                        @(a.PreferredEmploymentType == EmploymentType.Internship ? "Staj" : "İş")
                                    </span>
                                </td>
                                <td>@(a.CityName ?? "—")</td>
                                <td class="small text-secondary">@a.DeneyimMetni</td>
                                <td style="max-width: 220px;">
                                    @foreach (var s in a.Skills.Take(3))
                                    {
                                        <span class="cvm-skill-chip">@s</span>
                                    }
                                    @if (a.Skills.Count > 3)
                                    {
                                        <span class="text-secondary small">+@(a.Skills.Count - 3)</span>
                                    }
                                </td>
                                <td><span class="cvm-chip @DurumSinifi(a.Status)">@DurumMetni(a.Status)</span></td>
                                <td class="small text-secondary">
                                    @a.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </td>
                                <td class="text-end">
                                    <a asp-action="Candidate" asp-route-id="@a.Id"
                                       class="btn btn-sm btn-outline-secondary">Görüntüle</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-secondary small">
            @Model.ToplamKayit adaydan
            @((Model.Sayfa - 1) * Model.SayfaBoyutu + 1)–@(Math.Min(Model.Sayfa * Model.SayfaBoyutu, Model.ToplamKayit))
            arası gösteriliyor
        </span>

        @if (Model.ToplamSayfa > 1)
        {
            <div class="btn-group">
                <a class="btn btn-outline-secondary btn-sm @(Model.OncekiVar ? "" : "disabled")"
                   asp-action="Candidates"
                   asp-route-arama="@Model.Arama"
                   asp-route-cityId="@Model.CityId"
                   asp-route-employmentType="@Model.EmploymentType"
                   asp-route-status="@Model.Status"
                   asp-route-skillIds="@Model.SkillIds"
                   asp-route-minDeneyimYil="@Model.MinDeneyimYil"
                   asp-route-sayfa="@(Model.Sayfa - 1)">Önceki</a>

                <span class="btn btn-outline-secondary btn-sm disabled">
                    @Model.Sayfa / @Model.ToplamSayfa
                </span>

                <a class="btn btn-outline-secondary btn-sm @(Model.SonrakiVar ? "" : "disabled")"
                   asp-action="Candidates"
                   asp-route-arama="@Model.Arama"
                   asp-route-cityId="@Model.CityId"
                   asp-route-employmentType="@Model.EmploymentType"
                   asp-route-status="@Model.Status"
                   asp-route-skillIds="@Model.SkillIds"
                   asp-route-minDeneyimYil="@Model.MinDeneyimYil"
                   asp-route-sayfa="@(Model.Sayfa + 1)">Sonraki</a>
            </div>
        }
    </div>
}