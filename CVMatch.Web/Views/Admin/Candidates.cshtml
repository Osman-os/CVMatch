@model CVMatch.Web.Models.ViewModels.AdminCandidateListViewModel
@using CVMatch.Web.Models.Enums
@{
    ViewData["Title"] = "Adaylar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Adaylar</h1>
    <span class="text-secondary small">@Model.ToplamKayit kayıt</span>
</div>

<form method="get" asp-action="Candidates" class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label small">Ara</label>
                <input type="text" name="arama" value="@Model.Arama"
                       class="form-control" placeholder="Ad, e-posta veya başvuru no" />
            </div>

            <div class="col-md-3">
                <label class="form-label small">Şehir</label>
                <select name="cityId" class="form-select" asp-items="Model.Cities">
                    <option value="">Tümü</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small">Başvuru Türü</label>
                <select name="employmentType" class="form-select">
                    <option value="">Tümü</option>
                    <option value="@((int)EmploymentType.Internship)"
                            selected="@(Model.EmploymentType == EmploymentType.Internship)">Staj</option>
                    <option value="@((int)EmploymentType.FullTime)"
                            selected="@(Model.EmploymentType == EmploymentType.FullTime)">Tam Zamanlı</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small">Durum</label>
                <select name="status" class="form-select">
                    <option value="">Tümü</option>
                    @foreach (var s in Enum.GetValues<ApplicationStatus>())
                    {
                        <option value="@((int)s)" selected="@(Model.Status == s)">@s</option>
                    }
                </select>
            </div>
        </div>

        <div class="mt-3">
            <label class="form-label small d-block">
                Yetenekler
                <span class="text-secondary">— seçilenlerin hepsine sahip adaylar listelenir</span>
            </label>

            <div class="border rounded p-2" style="max-height: 160px; overflow-y: auto;">
                @foreach (var y in Model.TumYetenekler)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="skillIds"
                               value="@y.Id" id="skill-@y.Id" checked="@y.Secili" />
                        <label class="form-check-label small" for="skill-@y.Id">@y.Name</label>
                    </div>
                }
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Filtrele</button>
            @if (Model.FiltreVarMi)
            {
                <a asp-action="Candidates" class="btn btn-outline-secondary">Temizle</a>
            }
        </div>
    </div>
</form>

@if (Model.Adaylar.Count == 0)
{
    <div class="alert alert-light border">
        @(Model.FiltreVarMi ? "Bu filtrelere uyan aday bulunamadı." : "Henüz başvuru yok.")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr class="text-secondary small">
                    <th>Başvuru No</th>
                    <th>Ad Soyad</th>
                    <th>Şehir</th>
                    <th>Deneyim</th>
                    <th>Tür</th>
                    <th>Yetenekler</th>
                    <th>Durum</th>
                    <th>Tarih</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Adaylar)
                {
                    <tr>
                        <td class="font-monospace small">@a.ApplicationReferenceNumber</td>
                        <td>
                            <div>@a.FullName</div>
                            <div class="text-secondary small">@a.Email</div>
                        </td>
                        <td>@(a.CityName ?? "—")</td>
                        <td class="small">@a.DeneyimMetni</td>
                        <td class="small">
                            @(a.PreferredEmploymentType == EmploymentType.Internship ? "Staj" : "Tam Zamanlı")
                        </td>
                        <td style="max-width: 260px;">
                            @foreach (var s in a.Skills.Take(4))
                            {
                                <span class="badge rounded-pill text-bg-light border">@s</span>
                            }
                            @if (a.Skills.Count > 4)
                            {
                                <span class="text-secondary small">+@(a.Skills.Count - 4)</span>
                            }
                        </td>
                        <td><span class="badge text-bg-secondary">@a.Status</span></td>
                        <td class="small text-secondary">@a.SubmittedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.ToplamSayfa > 1)
    {
        <nav class="d-flex justify-content-between align-items-center">
            <span class="text-secondary small">
                Sayfa @Model.Sayfa / @Model.ToplamSayfa
            </span>
            <div class="btn-group">
                <a class="btn btn-outline-secondary btn-sm @(Model.OncekiVar ? "" : "disabled")"
                   asp-action="Candidates"
                   asp-route-arama="@Model.Arama"
                   asp-route-cityId="@Model.CityId"
                   asp-route-employmentType="@Model.EmploymentType"
                   asp-route-status="@Model.Status"
                   asp-route-skillIds="@Model.SkillIds"
                   asp-route-sayfa="@(Model.Sayfa - 1)">Önceki</a>

                <a class="btn btn-outline-secondary btn-sm @(Model.SonrakiVar ? "" : "disabled")"
                   asp-action="Candidates"
                   asp-route-arama="@Model.Arama"
                   asp-route-cityId="@Model.CityId"
                   asp-route-employmentType="@Model.EmploymentType"
                   asp-route-status="@Model.Status"
                   asp-route-skillIds="@Model.SkillIds"
                   asp-route-sayfa="@(Model.Sayfa + 1)">Sonraki</a>
            </div>
        </nav>
    }
}