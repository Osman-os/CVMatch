@model CVMatch.Web.Models.ViewModels.CvReviewViewModel
@using CVMatch.Web.Models.Enums

<input type="hidden" asp-for="SkillsCsv" id="skillsCsv" />

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Kişisel Bilgiler</h2>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-0">
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email"
                        placeholder="ad.soyad@ornek.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
                <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" type="tel"
                       inputmode="tel" placeholder="0532 123 45 67" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Adres Bilgileri</h2>

        <div class="mb-3">
            <label asp-for="CityId" class="form-label"></label>
            <select asp-for="CityId" class="form-select">
                <option value="">Seçiniz</option>
                @foreach (var city in Model.Cities)
                {
                    <option value="@city.Id">@city.Name</option>
                }
            </select>
        </div>

        <div class="mb-0">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0 border-0 pb-0">Eğitim</h2>
            <button type="button" class="btn btn-outline-primary btn-sm" id="addEducationTop">
                + Yeni Eğitim
            </button>
        </div>

        <div id="educationList">
            @for (var i = 0; i < Model.Educations.Count; i++)
            {
                <partial name="_EducationRow" model="Model.Educations[i]"
                         view-data="@(new ViewDataDictionary(ViewData) { { "Index", i } })" />
            }
        </div>

        @* Mevcut JavaScript bu düğmeyi dinliyor; üstteki düğme buna tıklar *@
        <button type="button" class="d-none" id="addEducation"></button>
    </div>
</div>
<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0 border-0 pb-0">İş Deneyimi</h2>
            <button type="button" class="btn btn-outline-primary btn-sm" id="addExperienceTop">
                + Yeni Deneyim
            </button>
        </div>

        <div id="experienceList">
            @for (var i = 0; i < Model.WorkExperiences.Count; i++)
            {
                <partial name="_ExperienceRow" model="Model.WorkExperiences[i]"
                         view-data="@(new ViewDataDictionary(ViewData) { { "Index", i } })" />
            }
        </div>

        <button type="button" class="d-none" id="addExperience"></button>

        <div class="cvm-total-exp">
            <label class="form-label mb-0">Toplam Deneyim</label>
            <div class="d-flex align-items-center gap-2">
                <input asp-for="ExperienceYears" type="number" min="0" max="60"
                       class="form-control form-control-sm" style="width: 72px;" />
                <span class="small text-secondary">yıl</span>

                <input asp-for="ExperienceMonths" type="number" min="0" max="11"
                       class="form-control form-control-sm" style="width: 72px;" />
                <span class="small text-secondary">ay</span>
            </div>
        </div>
        <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
        <span asp-validation-for="ExperienceMonths" class="text-danger small"></span>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0 border-0 pb-0">Projeler</h2>
            <button type="button" class="btn btn-outline-primary btn-sm" id="addProjectTop">
                + Yeni Proje
            </button>
        </div>

        <div id="projectList">
            @for (var i = 0; i < Model.Projects.Count; i++)
            {
                <partial name="_ProjectRow" model="Model.Projects[i]"
                         view-data="@(new ViewDataDictionary(ViewData) { { "Index", i } })" />
            }
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Yetenekler</h2>

        <div id="skillTags" class="d-flex flex-wrap gap-2 mb-3"></div>

        <div class="input-group cvm-skill-input">
                <input type="text" id="skillInput" class="form-control" maxlength="100"
                   placeholder="Yetenek yazın ve Enter'a basın" />
            <button type="button" class="btn btn-primary" id="addSkill">Ekle</button>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Bağlantılar</h2>

        <div class="mb-3">
            <label asp-for="LinkedInUrl" class="form-label"></label>
            <input asp-for="LinkedInUrl" class="form-control"
                   placeholder="linkedin.com/in/kullanici" />
            <span asp-validation-for="LinkedInUrl" class="text-danger small"></span>
        </div>

        <div class="mb-0">
            <label asp-for="GitHubUrl" class="form-label"></label>
            <input asp-for="GitHubUrl" class="form-control"
                   placeholder="github.com/kullanici" />
            <span asp-validation-for="GitHubUrl" class="text-danger small"></span>
        </div>
    </div>
</div>