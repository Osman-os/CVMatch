@{
    ViewData["Title"] = "Düzenleme bağlantısı geçersiz";
}

<div class="row justify-content-center">
    <div class="col-lg-6 text-center">
        <h1 class="h3 mb-3">Düzenleme bağlantısı geçersiz</h1>

        <p class="text-secondary">
            Bu bağlantı geçersiz veya süresi dolmuş olabilir. Düzenleme bağlantıları
            başvuru tarihinden itibaren 30 gün geçerlidir.
        </p>

        <div class="alert alert-light border text-start small">
            Başvurunuzda değişiklik yapmak veya verilerinizin silinmesini istemek için
            başvuru numaranızla <strong>kvkk@cvmatch.example</strong> adresine yazabilirsiniz.
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">Ana Sayfaya Dön</a>
    </div>
</div>