@model CVMatch.Web.Models.Entities.CvSubmission
@using CVMatch.Web.Models.Enums
@{
    ViewData["Title"] = "CV analiz ediliyor";
    var basliyor = Model.Status == SubmissionStatus.Uploaded;
}

<partial name="_Steps" model="1" />

<div class="cvm-processing-wrap">
    <div class="card">
        <div class="card-body cvm-processing-body">

            <div class="cvm-spinner"></div>

            <h1 class="h4 mb-2">CV'niz analiz ediliyor</h1>
            <p class="cvm-lead mb-1" id="durumMetni">
                Bilgileriniz çıkarılıyor.
            </p>
            <p class="cvm-muted small mb-4">
                Bu işlem yarım dakika kadar sürebilir.
            </p>

            <ul class="cvm-steps-list" id="adimListesi">
                <li data-adim="1">Dosya okunuyor</li>
                <li data-adim="2">Önizleme oluşturuluyor</li>
                <li data-adim="3">Metin çıkarılıyor</li>
                <li data-adim="4">Bilgiler yapılandırılıyor</li>
            </ul>

            <div class="cvm-processing-uyari">
                Lütfen bu sayfayı kapatmayın.
            </div>

        </div>
    </div>
</div>

@if (basliyor)
{
    <form id="startForm" method="post" asp-action="Start" asp-route-token="@Model.Token">
        @Html.AntiForgeryToken()
    </form>
}

@section Scripts {
    <script>
        // Adımları sırayla vurgula — gerçek ilerlemeyi değil, beklemeyi görselleştirir
        const adimlar = document.querySelectorAll('#adimListesi li');
        let sirada = 0;

        function adimIlerlet() {
            if (sirada > 0) adimlar[sirada - 1].classList.add('tamam');
            if (sirada < adimlar.length) {
                adimlar[sirada].classList.add('aktif');
                sirada++;
            }
        }

        adimIlerlet();
        const zamanlayici = setInterval(adimIlerlet, 4000);

        const form = document.getElementById('startForm');

        if (form) {
            const token =
                form.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch(form.action, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                },
                body: new FormData(form)
            })
                .then(r => {
                    if (!r.ok)
                        throw new Error('İstek başarısız');

                    return r.json();
                })
                .then(data => {
                    clearInterval(zamanlayici);
                    window.location.href = data.redirect;
                })
                .catch(() => {
                    clearInterval(zamanlayici);

                    document.getElementById('durumMetni').textContent =
                        'Bir sorun oluştu. Sayfayı yenilemeyi deneyin.';
                });
        }
        else {
            setTimeout(() => {
                window.location.reload();
            }, 4000);
        }
    </script>
}