@model CVMatch.Web.Models.ViewModels.EducationInputModel
@using CVMatch.Web.Models.Enums
@{
    var i = (int)ViewData["Index"]!;
    var prefix = $"Educations[{i}]";
}

<div class="border rounded p-3 mb-3 education-row">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="fw-semibold small">Eğitim Bilgisi</span>
        <button type="button" class="btn btn-link btn-sm text-danger p-0 remove-row">
            Sil
        </button>
    </div>

    <div class="mb-3">
        <label class="form-label">Eğitim Düzeyi</label>
        <select name="@(prefix).Level" class="form-select">
            <option value="">Seçiniz</option>
            <option value="@((int)EducationLevel.HighSchool)"
                    selected="@(Model.Level == EducationLevel.HighSchool)">Lise</option>
            <option value="@((int)EducationLevel.AssociateDegree)"
                    selected="@(Model.Level == EducationLevel.AssociateDegree)">Ön Lisans</option>
            <option value="@((int)EducationLevel.BachelorDegree)"
                    selected="@(Model.Level == EducationLevel.BachelorDegree)">Lisans</option>
            <option value="@((int)EducationLevel.MasterDegree)"
                    selected="@(Model.Level == EducationLevel.MasterDegree)">Yüksek Lisans</option>
            <option value="@((int)EducationLevel.Doctorate)"
                    selected="@(Model.Level == EducationLevel.Doctorate)">Doktora</option>
        </select>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">Okul</label>
            <input name="@(prefix).School" value="@Model.School" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Bölüm</label>
            <input name="@(prefix).FieldOfStudy" value="@Model.FieldOfStudy" class="form-control" />
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">Başlangıç Tarihi</label>
            <input name="@(prefix).StartDate" value="@Model.StartDate"
                   class="form-control" placeholder="aa/yyyy" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Bitiş Tarihi</label>
            <input name="@(prefix).EndDate" value="@Model.EndDate"
                   class="form-control end-date" placeholder="aa/yyyy"
                   disabled="@Model.IsCurrent" />
        </div>
    </div>

    <div class="form-check">
        <input type="checkbox" name="@(prefix).IsCurrent" value="true"
               class="form-check-input is-current"
               id="@(prefix)_IsCurrent"
               checked="@Model.IsCurrent" />
        <input type="hidden" name="@(prefix).IsCurrent" value="false" />
        <label class="form-check-label" for="@(prefix)_IsCurrent">Devam Ediyor</label>
    </div>
</div>