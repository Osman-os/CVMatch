@model CVMatch.Web.Models.ViewModels.ProjectInputModel
@{
    var i = (int)ViewData["Index"]!;
    var prefix = $"Projects[{i}]";
}

<div class="border rounded p-3 mb-3 project-row">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="fw-semibold small">Proje</span>
        <button type="button" class="btn btn-link btn-sm text-danger p-0 remove-row">
            Sil
        </button>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">Proje Adı</label>
            <input name="@(prefix).Name" value="@Model.Name" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Kullanılan Teknolojiler</label>
            <input name="@(prefix).Technologies" value="@Model.Technologies"
                   class="form-control" placeholder="React, TypeScript" />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Proje Bağlantısı</label>
        <input name="@(prefix).Url" value="@Model.Url"
               class="form-control" placeholder="github.com/kullanici/proje" />
    </div>

    <div class="mb-0">
        <label class="form-label">Açıklama</label>
        <textarea name="@(prefix).Description" class="form-control" rows="2">@Model.Description</textarea>
    </div>
</div>