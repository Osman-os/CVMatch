@model CVMatch.Web.Models.ViewModels.CvUploadViewModel
@{
    ViewData["Title"] = "CV Yükle";
}

<div class="cvm-upload-wrap">

    <a asp-action="Index" class="cvm-geri-link">← Tüm ilanlar</a>

    <h1 class="h3 mb-2">CV'nizi yükleyin</h1>
    <p class="cvm-lead mb-4">
        PDF biçimindeki CV'nizi ekleyin. Bilgileriniz otomatik çıkarılacak,
        göndermeden önce kontrol edip düzeltebileceksiniz.
    </p>

    <div class="card cvm-ilan-ozet-kart mb-3">
        <div class="card-body">
            <div class="cvm-ilan-ozet-etiket">Başvurduğunuz ilan</div>
            <h2 class="h5 mb-2">@Model.IlanBasligi</h2>
            <div class="cvm-ilan-meta">
                <span>@(Model.IlanSehri ?? "Konum belirtilmemiş")</span>
                <span class="cvm-ilan-meta-ayrac">·</span>
                <span>@(Model.IlanTuru == CVMatch.Web.Models.Enums.EmploymentType.Internship ? "Staj" : "Tam Zamanlı")</span>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
            }

            <form asp-action="Upload" method="post" enctype="multipart/form-data" id="uploadForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="JobPostingId" />

                <label class="cvm-dropzone" id="dropzone">
                    <span class="cvm-dropzone-icon">🗎</span>
                    <span class="cvm-dropzone-baslik">CV'nizi buraya sürükleyin</span>
                    <span class="cvm-dropzone-veya">veya</span>

                    <span class="btn btn-outline-primary" id="pickBtn">Bilgisayardan PDF Seç</span>

                    <input type="file" name="CvFile" id="cvFile"
                           accept="application/pdf" class="d-none" required />

                    <span class="cvm-dropzone-kural">
                        Yalnızca PDF · En fazla 10 MB
                    </span>
                </label>

                <div class="cvm-dosya-bilgi d-none" id="fileInfo" aria-live="polite">
                    <span class="cvm-dosya-ikon">✓</span>
                    <span id="fileName"></span>
                    <span class="cvm-dosya-boyut" id="fileSize"></span>
                </div>

                <div class="alert alert-danger d-none mt-3" id="fileError" role="alert"></div>

                <button type="submit" class="btn btn-primary btn-lg w-100 mt-4" id="submitBtn" disabled>
                    CV'yi Yükle
                </button>

                <p class="cvm-kvkk-not">
                    CV'nizdeki metin, bilgilerin otomatik çıkarılması amacıyla Anthropic
                    Claude hizmetine gönderilir.
                    <a asp-controller="Home" asp-action="Privacy">KVKK Aydınlatma Metni</a>
                </p>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const dosyaInput = document.getElementById('cvFile');
        const gonderBtn = document.getElementById('submitBtn');
        const alan = document.getElementById('dropzone');
        const bilgiKutu = document.getElementById('fileInfo');
        const bilgiAd = document.getElementById('fileName');
        const bilgiBoyut = document.getElementById('fileSize');
        const hataKutu = document.getElementById('fileError');

        // Sunucudaki 10 MB sınırı asıl güvence; bu kontrol yalnızca
        // büyük dosyanın boşuna yüklenip anlamsız hata vermesini önler
        const enFazlaBayt = 10 * 1024 * 1024;

        function temizle() {
            bilgiKutu.classList.add('d-none');
            hataKutu.classList.add('d-none');
            alan.classList.remove('secili');
            gonderBtn.disabled = true;
        }

        function hataGoster(mesaj) {
            temizle();
            hataKutu.textContent = mesaj;
            hataKutu.classList.remove('d-none');
            dosyaInput.value = '';
        }

        function dosyaSecildi(dosya) {
            if (!dosya) return;

            if (dosya.type !== 'application/pdf') {
                hataGoster('Yalnızca PDF dosyası yükleyebilirsiniz.');
                return;
            }

            const mb = (dosya.size / 1048576).toFixed(1);

            if (dosya.size > enFazlaBayt) {
                hataGoster(`Dosya boyutu 10 MB'ı aşamaz. Seçtiğiniz dosya ${mb} MB.`);
                return;
            }

            hataKutu.classList.add('d-none');
            bilgiAd.textContent = dosya.name;
            bilgiBoyut.textContent = mb + ' MB';
            bilgiKutu.classList.remove('d-none');
            alan.classList.add('secili');
            gonderBtn.disabled = false;
        }

        dosyaInput.addEventListener('change', () => dosyaSecildi(dosyaInput.files[0]));

        // Sürükle bırak
        ['dragenter', 'dragover'].forEach(olay => {
            alan.addEventListener(olay, e => {
                e.preventDefault();
                alan.classList.add('dragging');
            });
        });

        ['dragleave', 'drop'].forEach(olay => {
            alan.addEventListener(olay, e => {
                e.preventDefault();
                alan.classList.remove('dragging');
            });
        });

        alan.addEventListener('drop', e => {
            const dosya = e.dataTransfer.files[0];
            if (!dosya) return;

            if (dosya.type !== 'application/pdf') {
                hataGoster('Yalnızca PDF dosyası yükleyebilirsiniz.');
                return;
            }

            dosyaInput.files = e.dataTransfer.files;
            dosyaSecildi(dosya);
        });

        document.getElementById('uploadForm')?.addEventListener('submit', function () {
            gonderBtn.disabled = true;
            gonderBtn.textContent = 'Yükleniyor...';
        });
    </script>
}