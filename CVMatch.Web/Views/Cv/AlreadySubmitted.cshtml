@{
    ViewData["Title"] = "Başvurunuz alındı";
}

<div class="row justify-content-center">
    <div class="col-lg-6 text-center">
        <h1 class="h4 mb-3">Başvurunuz zaten tamamlandı</h1>

        <p class="text-secondary">
            Bu başvuru daha önce onaylanmış ve kaydedilmiştir.
        </p>

        <div class="alert alert-light border text-start small">
            Bilgilerinizi güncellemek isterseniz, başvuru tamamlandığında size verilen
            düzenleme bağlantısını kullanın. Bağlantıya erişemiyorsanız başvuru
            numaranızla bizimle iletişime geçin.
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">Ana Sayfaya Dön</a>
    </div>
</div>