@model CVMatch.Web.Models.ViewModels.CvReviewViewModel
@using CVMatch.Web.Models.Enums
@{
    ViewData["Title"] = "Bilgilerinizi kontrol edin";
}

<h1 class="h3 mb-1">Bilgilerinizi kontrol edin</h1>
<p class="text-secondary">
    CV'nizden çıkarılan bilgileri kontrol edin. Eksik veya hatalı alanları düzenleyebilirsiniz.
</p>

@if (Model.IsManualEntry)
{
    <div class="alert alert-warning">
        CV'nizden bilgi çıkarılamadı. Başvurunuzu tamamlamak için bilgilerinizi
        manuel olarak girin.
    </div>
}
else
{
    <div class="alert alert-info">
        Başvurunuz henüz gönderilmedi. Bilgileriniz onay aşamasından sonra kaydedilecektir.
    </div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

<form asp-action="Review" method="post" id="reviewForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Token" />
    <input type="hidden" asp-for="SkillsCsv" id="skillsCsv" />

    <div class="row g-4">
        <div class="col-lg-7">

            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Kişisel Bilgiler</h2>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Başvuru Türü <span class="text-danger">*</span></label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio"
                                       asp-for="PreferredEmploymentType"
                                       value="@EmploymentType.Internship"
                                       id="typeInternship" />
                                <label class="form-check-label" for="typeInternship">Staj</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio"
                                       asp-for="PreferredEmploymentType"
                                       value="@EmploymentType.FullTime"
                                       id="typeFullTime" />
                                <label class="form-check-label" for="typeFullTime">Tam Zamanlı İş</label>
                            </div>
                        </div>
                        <span asp-validation-for="PreferredEmploymentType" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Adres Bilgileri</h2>

                    <div class="mb-3">
                        <label asp-for="CityId" class="form-label"></label>
                        <select asp-for="CityId" class="form-select">
                            <option value="">Seçiniz</option>
                            @foreach (var city in Model.Cities)
                            {
                                <option value="@city.Id">@city.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-0">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Eğitim</h2>

                    <div id="educationList">
                        @for (var i = 0; i < Model.Educations.Count; i++)
                        {
                            <partial name="_EducationRow" model="Model.Educations[i]"
                                     view-data="@(new ViewDataDictionary(ViewData) { { "Index", i } })" />
                        }
                    </div>

                    <button type="button" class="btn btn-outline-primary btn-sm"
                            id="addEducation">
                        + Yeni Eğitim Ekle
                    </button>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">İş Deneyimi</h2>

                    <div id="experienceList">
                        @for (var i = 0; i < Model.WorkExperiences.Count; i++)
                        {
                            <partial name="_ExperienceRow" model="Model.WorkExperiences[i]"
                                     view-data="@(new ViewDataDictionary(ViewData) { { "Index", i } })" />
                        }
                    </div>

                    <button type="button" class="btn btn-outline-primary btn-sm mb-4"
                            id="addExperience">
                        + Yeni Deneyim Ekle
                    </button>

                    <hr />

                    <h3 class="h6 mb-3">Toplam Deneyim Süresi</h3>
                    <div class="row g-3">
                        <div class="col-6">
                            <label asp-for="ExperienceYears" class="form-label"></label>
                            <input asp-for="ExperienceYears" type="number" min="0" max="60"
                                   class="form-control" />
                            <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="ExperienceMonths" class="form-label"></label>
                            <input asp-for="ExperienceMonths" type="number" min="0" max="11"
                                   class="form-control" />
                            <span asp-validation-for="ExperienceMonths" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Yetenekler</h2>

                    <div id="skillTags" class="d-flex flex-wrap gap-2 mb-3"></div>

                    <div class="input-group">
                        <input type="text" id="skillInput" class="form-control"
                               placeholder="Yetenek yazın ve Enter'a basın" />
                        <button type="button" class="btn btn-outline-primary" id="addSkill">
                            Ekle
                        </button>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Bağlantılar</h2>

                    <div class="mb-3">
                        <label asp-for="LinkedInUrl" class="form-label"></label>
                        <input asp-for="LinkedInUrl" class="form-control" />
                        <span asp-validation-for="LinkedInUrl" class="text-danger small"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="GitHubUrl" class="form-label"></label>
                        <input asp-for="GitHubUrl" class="form-control" />
                        <span asp-validation-for="GitHubUrl" class="text-danger small"></span>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-lg-5">
            <div class="card position-sticky" style="top: 1rem;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0">CV Önizlemesi</h2>
                        <span class="badge text-bg-light">PDF - Sayfa 1</span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.PreviewImageFileName))
                    {
                        <img src="@Url.Action("File", new { token = Model.Token, type = "preview" })"
                             class="img-fluid border rounded" alt="CV önizlemesi" />
                    }
                    else
                    {
                        <p class="text-secondary small mb-0">Önizleme oluşturulamadı.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between border-top pt-3 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">Geri Dön</a>
        <button type="submit" class="btn btn-primary">Özete Devam Et</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.initialSkills = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                (Model.SkillsCsv ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries)));
    </script>
    <script src="/js/cv-review.js"></script>
}