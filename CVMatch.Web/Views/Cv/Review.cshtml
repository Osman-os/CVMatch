@model CVMatch.Web.Models.ViewModels.CvReviewViewModel
@{
    ViewData["Title"] = "Bilgilerinizi kontrol edin";
    ViewData["PageClass"] = "cvm-page-wide";
}

<partial name="_Steps" model="2" />

<h1 class="h3 mb-2">Bilgilerinizi kontrol edin</h1>
<p class="cvm-lead mb-4">
    CV'nizden çıkarılan bilgileri kontrol edin. Eksik veya hatalı alanları düzenleyebilirsiniz.
</p>

@if (TempData["Bilgi"] is string bilgi)
{
    <div class="alert alert-warning">@bilgi</div>
}

@if (Model.IsManualEntry)
{
    <div class="alert alert-warning">
        CV'nizden bilgi çıkarılamadı. Başvurunuzu tamamlamak için bilgilerinizi
        manuel olarak girin.
    </div>
}
else
{
    <div class="alert alert-info d-flex gap-2">
        <span>ⓘ</span>
        <span>
            Başvurunuz henüz gönderilmedi. Bilgileriniz şu an geçici taslak olarak tutuluyor;
            kalıcı başvuru kaydınız onayınızdan sonra oluşturulacaktır.
        </span>
    </div>
}

<div asp-validation-summary="All" class="alert alert-danger"></div>

<form asp-action="Review" method="post" id="reviewForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Token" />

    @for (var i = 0; i < Model.UncertainFields.Count; i++)
    {
        <input type="hidden" asp-for="UncertainFields[i]" />
    }

    <div class="row g-4">
        <div class="col-lg-7 cvm-form-col">

            @if (Model.UncertainFields.Count > 0)
            {
                <div class="cvm-belirsizlik-not">
                    <span class="cvm-uncertain-mark cvm-uncertain-mark-inline"
                          data-uncertain="AI bu bilgiden emin değil. Lütfen CV'nizle karşılaştırarak kontrol edin."
                          tabindex="0">!</span>
                    <span>İşaretli alanlar CV'nizden okunurken emin olunamadı, kontrol etmenizi öneririz.</span>
                </div>
            }

            <nav class="cvm-bolum-nav" aria-label="Form bölümleri">
                <a href="#bolum-kisisel">Kişisel</a>
                <a href="#bolum-adres">Adres</a>
                <a href="#bolum-egitim">Eğitim</a>
                <a href="#bolum-deneyim">Deneyim</a>
                <a href="#bolum-projeler">Projeler</a>
                <a href="#bolum-yetenekler">Yetenekler</a>
                <a href="#bolum-baglantilar">Bağlantılar</a>
            </nav>

            @await Html.PartialAsync("_CvFormFields", Model)
        </div>

        <div class="col-lg-5 cvm-preview-col">
            <div class="card cvm-preview-kart">
                <div class="card-body">
                    <div class="cvm-preview-baslik">
                        <h2 class="h6 mb-0">CV Önizlemesi</h2>
                        <span class="cvm-preview-etiket">PDF · Sayfa 1</span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.PreviewImageFileName))
                    {
                        <div class="cvm-preview-araclar">
                            <button type="button" class="cvm-preview-btn" id="zoomOut"
                                    aria-label="Uzaklaştır">−</button>
                            <span class="cvm-preview-oran" id="zoomLabel">100%</span>
                            <button type="button" class="cvm-preview-btn" id="zoomIn"
                                    aria-label="Yakınlaştır">+</button>
                            <button type="button" class="cvm-preview-btn" id="zoomReset"
                                    aria-label="Sıfırla">Sıfırla</button>
                            <a href="@Url.Action("File", new { token = Model.Token, type = "preview" })"
                               target="_blank" rel="noopener"
                               class="cvm-preview-btn cvm-preview-btn-son">Yeni sekmede aç</a>
                        </div>

                        <div class="cvm-preview-cerceve" id="previewFrame">
                            <img src="@Url.Action("File", new { token = Model.Token, type = "preview" })"
                                 id="previewImg" alt="CV önizlemesi" />
                        </div>
                    }
                    else
                    {
                        <p class="cvm-muted small mb-0">Önizleme oluşturulamadı.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="cvm-action-bar">
        <a asp-action="Index" class="btn btn-outline-secondary">Geri Dön</a>
        <button type="submit" class="btn btn-primary">Özete Devam Et →</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        window.initialSkills = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                (Model.SkillsCsv ?? "").Split(',',
                    StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)));

        window.uncertainFields = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(Model.UncertainFields));
    </script>

    <script src="/js/cv-review.js"></script>
    <script src="/js/cv-preview.js"></script>
}