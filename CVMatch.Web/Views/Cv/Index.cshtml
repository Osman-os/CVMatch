@model CVMatch.Web.Models.ViewModels.CvHomeViewModel
@{
    ViewData["Title"] = "Açık İlanlar";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center">
        <span>Yönetici olarak giriş yaptınız.</span>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-sm btn-primary">Yönetim Paneline Git</a>
    </div>
}

<div class="cvm-hero">
    <h1>Açık pozisyonlarımıza başvurun</h1>
    <p>
        Size uygun ilanı seçin, CV'nizi PDF olarak yükleyin.
        Bilgilerinizi kontrol edip onaylayın; başvurunuz tamamlanır.
    </p>

    <div class="cvm-hero-badges">
        <span class="cvm-trust"><span class="cvm-trust-tick">✓</span> Üyelik gerekmez</span>
        <span class="cvm-trust"><span class="cvm-trust-tick">✓</span> Göndermeden önce kontrol edin</span>
        <span class="cvm-trust"><span class="cvm-trust-tick">✓</span> Başvurunuz onayınızdan sonra oluşur</span>
    </div>
</div>

<section class="mb-5">
    @if (Model.Ilanlar.Count == 0)
    {
        <div class="card">
            <div class="card-body p-5 text-center">
                <h2 class="h5 mb-2">Şu anda açık ilan bulunmuyor</h2>
                <p class="text-secondary mb-0">
                    Yeni pozisyonlar açıldığında bu sayfada listelenecek.
                </p>
            </div>
        </div>
    }
    else
    {
        <h2 class="h4 mb-3">Açık İlanlar</h2>

                <div class="d-flex flex-column gap-3">
            @foreach (var ilan in Model.Ilanlar)
            {
                <div class="card">
                    <div class="card-body p-4">
                        <div class="row g-3 align-items-center">

                            <div class="col-lg-9">
                                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                    <h3 class="h5 mb-0">@ilan.Title</h3>
                                    <span class="cvm-chip @(ilan.EmploymentType == CVMatch.Web.Models.Enums.EmploymentType.Internship ? "cvm-chip-purple" : "cvm-chip-blue")">
                                        @ilan.TurMetni
                                    </span>
                                </div>

                                <div class="text-secondary small mb-2">
                                        @(ilan.CityName ?? "Konum belirtilmemiş") · @ilan.DeneyimMetni
                                </div>

                                @if (!string.IsNullOrWhiteSpace(ilan.Description))
                                {
                                    var ozet = ilan.Description!.Length > 160
                                        ? ilan.Description[..160].TrimEnd() + "…"
                                        : ilan.Description;

                                    <p class="small text-secondary mb-2">@ozet</p>
                                }

                                @if (ilan.ZorunluYetenekler.Count > 0 || ilan.TercihYetenekler.Count > 0)
                                {
                                    <div>
                                        @foreach (var y in ilan.ZorunluYetenekler)
                                        {
                                            <span class="cvm-chip cvm-chip-blue">@y</span>
                                        }
                                        @foreach (var y in ilan.TercihYetenekler)
                                        {
                                            <span class="cvm-chip">@y</span>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="col-lg-3 text-lg-end">
                                <a asp-action="Apply" asp-route-id="@ilan.Id"
                                   class="btn btn-primary w-100">Bu İlana Başvur</a>

                                <div class="cvm-ilan-tarih">
                                    @ilan.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy") tarihinde yayınlandı
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

<section class="cvm-how" id="nasil-calisir">
    <h2 class="h4 text-center mb-1">Nasıl Çalışır?</h2>
    <p class="text-center text-secondary mb-4">Üç adımda başvurunuzu tamamlayın.</p>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body p-4">
                    <span class="cvm-step-num">1</span>
                    <h3 class="h6">İlanı seçin, CV'nizi yükleyin</h3>
                    <p class="text-secondary small mb-0">
                        Başvurmak istediğiniz ilanı seçip PDF biçimindeki CV'nizi ekleyin.
                        Üyelik veya parola gerekmez.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body p-4">
                    <span class="cvm-step-num">2</span>
                    <h3 class="h6">Bilgilerinizi kontrol edin</h3>
                    <p class="text-secondary small mb-0">
                        CV'nizden çıkarılan bilgileri gözden geçirin ve eksikleri tamamlayın.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body p-4">
                    <span class="cvm-step-num">3</span>
                    <h3 class="h6">Başvurunuzu onaylayın</h3>
                    <p class="text-secondary small mb-0">
                        Özetinizi kontrol ederek başvurunuzu tamamlayın ve size özel
                        düzenleme bağlantınızı alın.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>